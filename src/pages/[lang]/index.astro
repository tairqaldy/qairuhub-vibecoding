---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/data/curriculum';
import { labs, modules } from '@/data/curriculum';
import { materials } from '@/data/materials';
import { tools } from '@/data/tools';
import { href } from '@/i18n/ui';

// Counted from the data. These used to be typed by hand and had drifted:
// the library said 167 when it held 139.
const materialCount = materials.reduce((n, c) => n + c.items.length, 0);
const toolCount = tools.length;

export const getStaticPaths = (() => [{ params: { lang: 'en' } }, { params: { lang: 'kk' } }]) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const c = {
  en: {
    kicker: 'Free · English & Kazakh · QairuHub',
    h1a: 'Everything about',
    h1b: 'vibecoding',
    h1c: 'in one place',
    lead: 'The tools, the models, the workflow and the failures. Taught hands-on, in English and Kazakh.',
    start: 'Try it in 10 minutes',
    learnCta: 'Start the course',

    tryH: 'You cannot read your way to this',
    tryP: 'Ten minutes with a real agent teaches you more than a week of articles. No card, no experience needed.',
    tryBtn: 'Your first 10 minutes',

    insideK: 'Four things',
    inside: [
      { t: 'The course', d: `${modules.length} modules, from what vibe coding means to running several agents at once.`, to: 'learn', meta: '~2h' },
      { t: 'The labs', d: `${labs.length} guided sessions on your own machine. Exact commands, exact prompts.`, to: 'labs', meta: 'hands-on' },
      { t: 'Tools & models', d: 'Every serious AI coding tool side by side. Free tiers and real weaknesses.', to: 'tools', meta: `${toolCount} tools` },
      { t: 'The library', d: 'The docs, research and incidents worth your time, sorted by what you need.', to: 'materials', meta: `${materialCount} links` },
    ],

    honestH: 'We tell you what does not work, too',
    honestP: 'AI coding is useful and oversold. Both sides are here with sources: the trial where developers were 19% slower while feeling faster, and the production database an agent deleted during a code freeze.',
    builtP: 'This site was built overnight by a team of AI agents directed by one person. The last module opens the whole run, including what went wrong.',
    seeHow: 'Read how it was built',
  },
  kk: {
    kicker: 'Тегін · Ағылшынша және қазақша · QairuHub',
    h1a: 'Vibecoding туралы',
    h1b: 'бәрі',
    h1c: 'бір жерде',
    lead: 'Құралдар, модельдер, жұмыс тәсілі және сәтсіздіктер. Тәжірибе арқылы, ағылшынша және қазақша.',
    start: '10 минутта байқап көр',
    learnCta: 'Курсты бастау',

    tryH: 'Мұны оқып үйрену мүмкін емес',
    tryP: 'Нағыз agent-пен өткізген он минут бір апта мақала оқығаннан көп үйретеді. Карта да, тәжірибе де керек емес.',
    tryBtn: 'Алғашқы 10 минутың',

    insideK: 'Төрт бөлім',
    inside: [
      { t: 'Курс', d: `Vibe coding деген не екенінен бірнеше agent-ті қатар басқаруға дейін — ${modules.length} модуль.`, to: 'learn', meta: '~2 сағ' },
      { t: 'Практика', d: `Өз компьютеріңде орындайтын ${labs.length} сабақ. Нақты командалар, нақты prompt-тар.`, to: 'labs', meta: 'тәжірибе' },
      { t: 'Құралдар мен модельдер', d: 'Барлық негізгі ЖИ құралы қатар. Тегін мүмкіндіктері мен шын кемшіліктері.', to: 'tools', meta: `${toolCount} құрал` },
      { t: 'Кітапхана', d: 'Уақытыңа тұрарлық құжаттама, зерттеу және оқиғалар — керегіңе қарай сұрыпталған.', to: 'materials', meta: `${materialCount} сілтеме` },
    ],

    honestH: 'Не жұмыс істемейтінін де айтамыз',
    honestP: 'ЖИ-мен кодтау пайдалы да, асыра дәріптелген де. Мұнда екі жағы да дереккөзімен: әзірлеушілер өздерін жылдам сезініп, шын мәнінде 19%-ға баяу болған зерттеу де, agent код мұздатылған кезде өшіріп жіберген production дерекқоры да.',
    builtP: 'Бұл сайтты бір адам басқарған ЖИ agent-тер командасы бір түнде құрастырды. Соңғы модуль сол жұмысты толық ашады, қате кеткен тұстарымен бірге.',
    seeHow: 'Қалай жасалғанын оқу',
  },
}[lang];
---

<BaseLayout lang={lang}>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">{c.kicker}</p>
      <h1>
        <span class="block">{c.h1a}</span>
        <span class="brand block">{c.h1b}</span>
        <span class="block">{c.h1c}</span>
      </h1>
      <p class="lead">{c.lead}</p>
      <div class="cta">
        <a class="btn btn-signal" href={href(lang, 'try')}>{c.start}</a>
        <a class="btn" href={href(lang, 'learn')}>{c.learnCta} →</a>
      </div>
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <a class="try" href={href(lang, 'try')}>
      <div class="try-text">
        <h2>{c.tryH}</h2>
        <p>{c.tryP}</p>
        <span class="try-go">{c.tryBtn} →</span>
      </div>
      <div class="try-term" aria-hidden="true">
        <code><span>$</span> npm install -g @anthropic-ai/claude-code</code>
        <code><span>$</span> claude</code>
        <code class="dim">❯ build me a page that counts down to my birthday</code>
        <code class="ok">✓ done — open index.html</code>
      </div>
    </a>
  </section>

  <section class="wrap band" data-reveal>
    <p class="eyebrow">{c.insideK}</p>
    <div class="inside">
      {
        c.inside.map((x, i) => (
          <a class="card-i" href={href(lang, x.to)} data-reveal style={`--i:${i}`}>
            <span class="i-meta">{x.meta}</span>
            <span class="i-t">{x.t}</span>
            <span class="i-d">{x.d}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap band last" data-reveal>
    <div class="notes">
      <div class="note">
        <h2>{c.honestH}</h2>
        <p>{c.honestP}</p>
      </div>
      <div class="note">
        <p class="built">{c.builtP}</p>
        <a class="quiet" href={href(lang, 'learn/overnight-builds')}>{c.seeHow} →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* A calm landing: one hook, one invitation, four doors, two honest notes. */
  .hero { padding: clamp(60px, 12vw, 132px) 0 clamp(20px, 4vw, 40px); }
  .kicker { margin: 0 0 26px; font: 500 12px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-faint); }
  h1 { font-size: clamp(42px, 9vw, 96px); font-weight: 300; letter-spacing: -0.045em; line-height: 1.0; }
  .block { display: block; }
  .brand { font-family: var(--font-brand); font-weight: 400; font-size: 0.92em; line-height: 1.15; color: var(--color-signal-soft); letter-spacing: -0.01em; padding: 0.04em 0; }
  .lead { max-width: 52ch; margin: 30px 0 0; font-size: clamp(17px, 2vw, 20px); line-height: 1.6; color: var(--color-muted); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .band { padding: clamp(44px, 7vw, 78px) 0 0; }
  .last { padding-bottom: 20px; }
  .eyebrow { margin: 0 0 22px; }

  /* the one invitation */
  .try { display: grid; gap: 26px; padding: 30px 26px; border-radius: 26px; text-decoration: none; color: inherit;
         border: 1px solid rgb(43 127 255 / 0.32); background: linear-gradient(135deg, rgb(43 127 255 / 0.1), transparent 62%);
         transition: border-color 0.3s, transform 0.5s var(--ease-out-expo); }
  .try:hover { border-color: rgb(43 127 255 / 0.6); transform: translateY(-2px); }
  .try h2 { font-size: clamp(25px, 3.6vw, 38px); font-weight: 350; }
  .try p { margin: 14px 0 0; max-width: 46ch; font-size: 16.5px; line-height: 1.6; color: var(--color-muted); }
  .try-go { display: inline-block; margin-top: 20px; font: 500 14px/1 var(--font-mono); color: var(--color-signal-soft); }
  .try-term { display: grid; gap: 7px; align-content: center; padding: 18px; border-radius: 16px; background: #05060f; border: 1px solid var(--color-line); overflow: hidden; }
  .try-term code { font: 400 12.5px/1.5 var(--font-mono); color: #dbe2f7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .try-term code span { color: var(--color-signal-soft); }
  .try-term .dim { color: var(--color-faint); }
  .try-term .ok { color: var(--color-ok); }

  /* four doors */
  .inside { display: grid; gap: 12px; }
  .card-i { display: grid; gap: 8px; align-content: start; padding: 24px 22px; border-radius: 20px;
            border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.028); text-decoration: none; color: inherit;
            transition: border-color 0.25s, background 0.25s, transform 0.45s var(--ease-out-expo); }
  .card-i:hover { border-color: rgb(43 127 255 / 0.45); background: rgb(255 255 255 / 0.055); transform: translateY(-2px); }
  .i-meta { font: 400 11px/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); }
  .i-t { font: 400 23px/1.2 var(--font-display); letter-spacing: -0.02em; color: #fff; }
  .i-d { font-size: 15px; line-height: 1.55; color: var(--color-muted); }

  /* two quiet notes */
  .notes { display: grid; gap: 14px; }
  .note { padding: 26px 24px; border-radius: 22px; border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.022); }
  .note h2 { font-size: clamp(21px, 2.8vw, 27px); font-weight: 400; }
  .note p { margin: 14px 0 0; font-size: 15.5px; line-height: 1.65; color: var(--color-muted); }
  .note .built { margin: 0; }
  .quiet { display: inline-block; margin-top: 16px; font: 500 13px/1 var(--font-mono); color: var(--color-signal-soft); text-decoration: none; }
  .quiet:hover { text-decoration: underline; }

  @media (min-width: 820px) {
    .try { grid-template-columns: 1.1fr 0.9fr; align-items: center; padding: 42px 38px; }
    .inside { grid-template-columns: repeat(2, 1fr); }
    .notes { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1100px) { .inside { grid-template-columns: repeat(4, 1fr); } }
</style>
