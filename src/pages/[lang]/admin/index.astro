---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdminStats from '@/components/widgets/AdminStats';
import type { Lang } from '@/data/curriculum';

export const getStaticPaths = (() => [{ params: { lang: 'en' } }, { params: { lang: 'kk' } }]) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };
---

<BaseLayout lang={lang} title="Statistics" description="Aggregate learner statistics." noindex>
  <section class="wrap page">
    <p class="kicker">QairuHub · private</p>
    <h1>Statistics</h1>
    <p class="lead">
      Aggregate numbers only. No names, no emails, no individual progress — the API does not return them, so this page
      cannot show them.
    </p>
    <AdminStats client:load />
  </section>
</BaseLayout>

<style>
  .page { padding: clamp(40px, 7vw, 80px) 0 60px; }
  .kicker { margin: 0 0 16px; font: 500 12px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-signal-soft); }
  h1 { font-size: clamp(38px, 7vw, 64px); font-weight: 300; letter-spacing: -0.04em; }
  .lead { max-width: 58ch; margin: 20px 0 8px; font-size: 17px; line-height: 1.6; color: var(--color-muted); }
</style>
