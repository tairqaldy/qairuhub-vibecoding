---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/data/curriculum';
import { href } from '@/i18n/ui';

export const getStaticPaths = (() => [{ params: { lang: 'en' } }, { params: { lang: 'kk' } }]) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const c = {
  en: {
    title: 'Your first 10 minutes',
    desc: 'Three ways to try AI coding right now, free, on whatever device you have. Pick one and actually do it.',
    kicker: 'Start here · 10 minutes',
    h1a: 'Stop reading.',
    h1b: 'Start typing.',
    lead: 'Nobody has ever learned this from a page. Pick the track that matches what you have in front of you, spend ten minutes, and build one small real thing. Everything else on this site will make more sense afterwards.',
    pickTrack: 'Pick your track',
    why: 'Why ten minutes matters',
    whyBody:
      'The gap between reading about agents and using one is bigger than it looks. Until you have watched a model confidently write something wrong, and then fixed it, the warnings in this course are just words. Ten minutes of real contact does more than an hour of video.',
    tracks: [
      {
        id: 'browser',
        tag: 'No install · Free',
        name: 'In your browser',
        who: 'You have a phone or a locked-down computer, or you just want to see it work first.',
        mins: '5 min',
        steps: [
          { t: 'Open a free AI chat', d: 'Any of claude.ai, chatgpt.com, or gemini.google.com. All have a free tier that is enough for this.' },
          { t: 'Ask for one complete file', d: 'Copy the prompt below. Asking for a single self-contained HTML file matters: it means you can run the result with no setup at all.' },
          { t: 'Save it and open it', d: 'Copy the code into a text editor, save it as countdown.html, and double-click the file. That is a working web page you made.' },
          { t: 'Now change one thing', d: 'Go back and ask for one change — a different colour, your own date, a sound at zero. Watch how you describe it. That is the whole skill.' },
        ],
        prompt: `Write a complete, single-file HTML page that counts down to 1 January 2027.

Requirements:
- One file. All CSS and JavaScript inline. No external libraries.
- Big readable numbers: days, hours, minutes, seconds, updating every second.
- Dark background, works on a phone screen.
- Put my name at the top: <your name>

Return only the file contents, nothing else.`,
        done: 'You have a working page, made by describing it. That is vibe coding, in the original sense.',
      },
      {
        id: 'terminal',
        tag: 'Laptop · The real thing',
        name: 'A real coding agent',
        who: 'You have a laptop you can install things on. This is the track the rest of the course builds on.',
        mins: '10 min',
        steps: [
          { t: 'Install Node, if you do not have it', d: 'Get the LTS version from nodejs.org. Then check it worked: the command below should print a version number.' },
          { t: 'Install a coding agent', d: 'Claude Code is what this course uses. Gemini CLI is free and works the same way if you would rather not pay for anything yet.' },
          { t: 'Make an empty folder and go into it', d: 'Never point an agent at your whole computer. Give it one small folder that contains only this experiment.' },
          { t: 'Start it and ask for something real', d: 'Run the agent, then type a request in plain language. Watch which files it decides to create before you accept anything.' },
          { t: 'Read what it did', d: 'Ask it to explain its own work. An agent that can explain its choices is one you can correct. This habit is worth more than any prompt trick.' },
        ],
        prompt: `Build a single-page countdown site for a QairuHub event on 1 December 2026.

- Plain HTML, CSS and JavaScript. No framework, no build step.
- A big countdown, the event name, and a short description.
- Dark theme, mobile first.

Before you write anything: tell me what files you plan to create and why. Wait for me to say go.`,
        done: 'You have run a real agent, reviewed a plan, and shipped a file. Lab 01 picks up exactly here.',
      },
      {
        id: 'ship',
        tag: 'Bonus · Free',
        name: 'Put it on the internet',
        who: 'You finished either track above and want a link you can send someone.',
        mins: '5 min',
        steps: [
          { t: 'Open a free host', d: 'Go to app.netlify.com/drop or pages.cloudflare.com. Neither needs a card for a small static site.' },
          { t: 'Drag your folder in', d: 'Netlify Drop takes a folder with an index.html and gives you a URL. Rename your file to index.html first.' },
          { t: 'Send the link to someone', d: 'This is the moment it stops being a file on your laptop and becomes a thing that exists. Do not skip it.' },
        ],
        prompt: null,
        done: 'Something you described in words is now live at a URL. Module 12 covers how all of this actually works.',
      },
    ],
    stuckH: 'If it goes wrong',
    stuck: [
      { q: 'The code it gave me does not work.', a: 'Good — this is the normal case, not a failure. Paste the exact error back to it, along with what you expected to happen. Do not paraphrase the error; the full text is the useful part.' },
      { q: 'It keeps giving me something different from what I asked.', a: 'Your request is probably under-specified rather than misunderstood. Add the constraint you have in your head but did not type. Module 07 is entirely about this.' },
      { q: 'I cannot pay for anything.', a: 'Gemini CLI has a free tier, and the browser track needs nothing at all. The tools page lists every free option honestly, including what each one limits.' },
      { q: 'It asked to run a command and I do not know if that is safe.', a: 'Read the command before approving it. If it deletes, force-pushes, or touches anything outside your test folder, say no. Module 11 is the full version of this rule.' },
    ],
    nextH: 'Now the rest will make sense',
    nextP: 'You have something that works and, probably, something that did not the first time. That is the right state to start from.',
    nextPath: 'Start the full path',
    nextTools: 'Compare every tool',
    copyLabel: 'Copy this prompt',
    copied: 'Copied',
    doneLabel: 'You are done when',
  },
  kk: {
    title: 'Алғашқы 10 минутың',
    desc: 'ЖИ-мен кодтауды дәл қазір, тегін, қолыңдағы кез келген құрылғыда байқап көрудің үш жолы. Бірін таңда да, шынымен істе.',
    kicker: 'Осыдан баста · 10 минут',
    h1a: 'Оқуды қой.',
    h1b: 'Жаза бастa.',
    lead: 'Мұны бет оқып ешкім үйренген емес. Қолыңда барына сай жолды таңда, он минут бөл де, кішкентай бірақ нақты нәрсе жаса. Сайттағы қалғанының бәрі содан кейін әлдеқайда түсінікті болады.',
    pickTrack: 'Жолыңды таңда',
    why: 'Он минут неге маңызды',
    whyBody:
      'Agent туралы оқу мен agent-ті қолданудың арасы көрінгеннен әлдеқайда үлкен. Модель сенімді түрде қате нәрсе жазғанын, содан соң оны өзің түзегеніңді көрмейінше, бұл курстағы ескертулер жай сөз болып қала береді. Он минуттық нақты байланыс бір сағаттық видеодан көп береді.',
    tracks: [
      {
        id: 'browser',
        tag: 'Орнатусыз · Тегін',
        name: 'Браузерде',
        who: 'Қолыңда телефон немесе шектеулі компьютер бар, не болмаса алдымен жұмыс істейтінін көргің келеді.',
        mins: '5 мин',
        steps: [
          { t: 'Тегін ЖИ чатын аш', d: 'claude.ai, chatgpt.com немесе gemini.google.com — қайсысы болса да. Бәрінде осыған жететін тегін мүмкіндік бар.' },
          { t: 'Бір толық файл сұра', d: 'Төмендегі prompt-ты көшір. Бір өзі жеткілікті HTML файлын сұрау маңызды: нәтижені ешқандай дайындықсыз іске қоса аласың.' },
          { t: 'Сақтап, ашып көр', d: 'Кодты мәтін редакторына көшір, countdown.html деп сақта да, файлды екі рет бас. Бұл — өзің жасаған жұмыс істейтін веб-бет.' },
          { t: 'Енді бір нәрсені өзгерт', d: 'Қайта барып бір өзгеріс сұра — басқа түс, өз күнің, нөлге жеткенде дыбыс. Оны қалай сипаттағаныңа назар сал. Бар шеберлік осында.' },
        ],
        prompt: `2027 жылдың 1 қаңтарына дейін санайтын толық, бір файлдан тұратын HTML бет жаз.

Талаптар:
- Бір файл. Барлық CSS пен JavaScript ішінде. Сыртқы кітапхана жоқ.
- Ірі, оқуға ыңғайлы сандар: күн, сағат, минут, секунд — әр секунд сайын жаңарады.
- Қараңғы фон, телефон экранында жақсы көрінеді.
- Жоғарғы жағына менің атымды қой: <атың>

Тек файл мазмұнын қайтар, басқа ештеңе жазба.`,
        done: 'Сипаттап отырып жасаған, жұмыс істейтін бетің бар. Бастапқы мағынасындағы vibe coding — дәл осы.',
      },
      {
        id: 'terminal',
        tag: 'Ноутбук · Нағыз нұсқа',
        name: 'Нағыз coding agent',
        who: 'Бағдарлама орната алатын ноутбугың бар. Курстың қалған бөлігі осы жолдың үстіне құрылады.',
        mins: '10 мин',
        steps: [
          { t: 'Node жоқ болса, орнат', d: 'nodejs.org сайтынан LTS нұсқасын ал. Содан соң тексер: төмендегі команда нұсқа нөмірін шығаруы керек.' },
          { t: 'Coding agent орнат', d: 'Бұл курс Claude Code-ты қолданады. Әзірге ештеңеге төлегің келмесе, Gemini CLI тегін әрі дәл солай жұмыс істейді.' },
          { t: 'Бос қалта жасап, ішіне кір', d: 'Agent-ті ешқашан бүкіл компьютеріңе бағыттама. Оған тек осы тәжірибе жатқан бір кішкентай қалта бер.' },
          { t: 'Іске қосып, нақты нәрсе сұра', d: 'Agent-ті жүргіз де, қарапайым тілмен сұрауыңды жаз. Бірдеңені қабылдамас бұрын қандай файл жасамақ екенін қара.' },
          { t: 'Не істегенін оқы', d: 'Өз жұмысын түсіндіруін сұра. Таңдауын түсіндіре алатын agent-ті түзете де аласың. Бұл әдет кез келген prompt айласынан құнды.' },
        ],
        prompt: `2026 жылдың 1 желтоқсанындағы QairuHub іс-шарасына арналған бір беттік countdown сайтын құрастыр.

- Таза HTML, CSS және JavaScript. Framework жоқ, build қадамы жоқ.
- Ірі countdown, іс-шара атауы және қысқа сипаттама.
- Қараңғы тақырып, алдымен мобильді.

Ештеңе жазбас бұрын: қандай файл жасамақ екеніңді және неге екенін айт. Мен «жарайды» дегенше күт.`,
        done: 'Нағыз agent-ті іске қостың, жоспарын қарадың, файл шығардың. 01-практика дәл осы жерден жалғасады.',
      },
      {
        id: 'ship',
        tag: 'Бонус · Тегін',
        name: 'Интернетке шығар',
        who: 'Жоғарыдағы екі жолдың бірін бітірдің де, біреуге жіберетін сілтеме алғың келеді.',
        mins: '5 мин',
        steps: [
          { t: 'Тегін хостинг аш', d: 'app.netlify.com/drop немесе pages.cloudflare.com. Шағын статикалық сайт үшін екеуіне де карта керек емес.' },
          { t: 'Қалтаңды сүйреп апар', d: 'Netlify Drop ішінде index.html бар қалтаны қабылдап, саған URL береді. Алдымен файлыңның атын index.html деп өзгерт.' },
          { t: 'Сілтемені біреуге жібер', d: 'Дәл осы сәтте ол ноутбугыңдағы файл болудан қалып, шынымен бар нәрсеге айналады. Бұл қадамды өткізіп жіберме.' },
        ],
        prompt: null,
        done: 'Сөзбен сипаттаған нәрсең енді нақты URL-де тұр. 12-модуль мұның бәрі қалай жұмыс істейтінін түсіндіреді.',
      },
    ],
    stuckH: 'Бірдеңе дұрыс болмаса',
    stuck: [
      { q: 'Берген коды жұмыс істемейді.', a: 'Жақсы — бұл сәтсіздік емес, қалыпты жағдай. Қатенің дәл мәтінін және не күткеніңді жазып, оған қайта жібер. Қатені өз сөзіңмен айтпа; ең пайдалысы — толық мәтіні.' },
      { q: 'Сұрағаныма мүлде ұқсамайтын нәрсе беріп жатыр.', a: 'Мәселе түсінбеуінде емес, сұрауыңның толық болмауында шығар. Ойыңда бар, бірақ жазбаған шартты қос. 07-модуль түгелдей осы туралы.' },
      { q: 'Ештеңеге төлей алмаймын.', a: 'Gemini CLI-де тегін мүмкіндік бар, ал браузер жолына мүлде ештеңе керек емес. Құралдар бетінде әр тегін нұсқа және оның нақты шектеулері адал жазылған.' },
      { q: 'Команда жүргізуді сұрады, бірақ қауіпсіз бе — білмеймін.', a: 'Мақұлдамас бұрын команданы оқы. Егер ол жойса, күштеп push жасаса немесе тест қалтаңнан тыс жерге тисе — жоқ де. 11-модуль осы ереженің толық нұсқасы.' },
    ],
    nextH: 'Енді қалғаны түсінікті болады',
    nextP: 'Қолыңда жұмыс істейтін нәрсе бар, әрі бірінші реттен шықпаған бірдеңе де бар шығар. Бастауға дәл осындай күй керек.',
    nextPath: 'Толық жолды бастау',
    nextTools: 'Барлық құралды салыстыру',
    copyLabel: 'Осы prompt-ты көшір',
    copied: 'Көшірілді',
    doneLabel: 'Аяқталды деп есепте, егер',
  },
}[lang];

const cmds: Record<string, { label: string; code: string }[]> = {
  terminal: [
    { label: 'check Node', code: 'node -v' },
    { label: 'Claude Code', code: 'npm install -g @anthropic-ai/claude-code' },
    { label: 'or Gemini CLI (free)', code: 'npm install -g @google/gemini-cli' },
    { label: 'a clean folder', code: 'mkdir countdown && cd countdown' },
    { label: 'start it', code: 'claude' },
  ],
};
---

<BaseLayout lang={lang} title={c.title} description={c.desc}>
  <section class="hero wrap">
    <p class="kicker">{c.kicker}</p>
    <h1>
      <span class="block">{c.h1a}</span>
      <span class="block accent">{c.h1b}</span>
    </h1>
    <p class="lead">{c.lead}</p>
  </section>

  <section class="wrap band" data-reveal>
    <div class="why">
      <p class="eyebrow">{c.why}</p>
      <p>{c.whyBody}</p>
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <p class="eyebrow">{c.pickTrack}</p>
    <div class="tracks">
      {
        c.tracks.map((tr, i) => (
          <article class="track" data-reveal style={`--i:${i}`}>
            <header>
              <span class="pill pill-act">{tr.tag}</span>
              <span class="mins">{tr.mins}</span>
            </header>
            <h2>{tr.name}</h2>
            <p class="who">{tr.who}</p>

            <ol class="steps">
              {tr.steps.map((s) => (
                <li>
                  <span class="s-t">{s.t}</span>
                  <span class="s-d">{s.d}</span>
                </li>
              ))}
            </ol>

            {
              cmds[tr.id] && (
                <div class="term">
                  <div class="term-bar">
                    <span class="term-dots"><i /><i /><i /></span>
                    <span>terminal</span>
                  </div>
                  <div class="term-body cmds">
                    {cmds[tr.id].map((cm) => (
                      <div class="cmd">
                        <code><span class="pr">$</span> {cm.code}</code>
                        <span class="cmt"># {cm.label}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }

            {
              tr.prompt && (
                <div class="promptbox" data-copy-root>
                  <div class="pb-bar">
                    <span class="pb-t">{c.copyLabel}</span>
                    <button type="button" class="btn btn-sm" data-copy data-copied={c.copied}>
                      ⧉
                    </button>
                  </div>
                  <pre>{tr.prompt}</pre>
                </div>
              )
            }

            <p class="done"><span>{c.doneLabel}</span> {tr.done}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <h2 class="h2">{c.stuckH}</h2>
    <div class="stuck">
      {
        c.stuck.map((s) => (
          <details>
            <summary>{s.q}</summary>
            <p>{s.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <div class="next">
      <h2 class="h2">{c.nextH}</h2>
      <p class="lead-sm">{c.nextP}</p>
      <div class="cta">
        <a class="btn btn-signal" href={href(lang, 'learn/the-tweet')}>{c.nextPath} →</a>
        <a class="btn" href={href(lang, 'tools')}>{c.nextTools}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(48px, 8vw, 92px) 0 0; }
  .kicker { margin: 0 0 20px; font: 500 12px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-signal-soft); }
  h1 { font-size: clamp(42px, 9vw, 88px); font-weight: 300; letter-spacing: -0.045em; line-height: 0.98; }
  .block { display: block; }
  .accent { color: var(--color-signal-soft); }
  .lead { max-width: 60ch; margin: 28px 0 0; font-size: clamp(17px, 2vw, 20px); line-height: 1.6; color: var(--color-muted); }
  .lead-sm { max-width: 58ch; margin: 16px 0 0; font-size: 17px; color: var(--color-muted); }

  .band { padding: clamp(40px, 6vw, 72px) 0 0; }
  .h2 { font-size: clamp(26px, 4vw, 40px); font-weight: 350; }

  .why { padding: 24px 26px; border-radius: 20px; border-left: 3px solid var(--color-signal); background: rgb(43 127 255 / 0.08); }
  .why p { margin: 10px 0 0; font-size: 17px; line-height: 1.65; color: #fff; max-width: 62ch; }

  .tracks { display: grid; gap: 18px; margin-top: 28px; }
  .track { padding: 26px 24px; border-radius: 24px; border: 1px solid var(--color-line); background: var(--color-fill); }
  .track header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mins { font: 500 12px/1 var(--font-mono); color: var(--color-faint); }
  .track h2 { margin-top: 16px; font-size: clamp(24px, 3vw, 30px); font-weight: 400; }
  .who { margin: 8px 0 0; font-size: 15.5px; color: var(--color-muted); }

  .steps { list-style: none; counter-reset: s; margin: 22px 0 0; padding: 0; display: grid; gap: 14px; }
  .steps li { counter-increment: s; display: grid; gap: 3px; padding-left: 38px; position: relative; }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgb(43 127 255 / 0.5); background: rgb(43 127 255 / 0.12); font: 500 12px/1 var(--font-mono); color: var(--color-signal-soft); }
  .s-t { font-weight: 600; font-size: 16px; color: #fff; }
  .s-d { font-size: 15px; line-height: 1.55; color: var(--color-muted); }

  .term { margin-top: 20px; }
  .cmds { display: grid; gap: 7px; }
  .cmd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .cmd code { font-size: 13px; color: #fff; }
  .pr { color: var(--color-signal-soft); }
  .cmt { font-size: 12px; color: var(--color-faint); }

  .promptbox { margin-top: 18px; border-radius: 16px; border: 1px solid rgb(43 127 255 / 0.35); background: rgb(43 127 255 / 0.07); overflow: hidden; }
