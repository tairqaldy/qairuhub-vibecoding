---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/data/curriculum';
import { href } from '@/i18n/ui';

export const getStaticPaths = (() => [{ params: { lang: 'en' } }, { params: { lang: 'kk' } }]) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const c = {
  en: {
    title: 'Your first 10 minutes',
    desc: 'Three ways to try AI coding right now, free, on any device. Pick one and do it.',
    kicker: 'Start here · 10 minutes',
    h1a: 'Stop reading.',
    h1b: 'Start typing.',
    lead: 'Nobody learns this from a page. Pick the track that fits what you have, spend ten minutes, build one small real thing. The rest of the site makes sense after that.',
    pickTrack: 'Pick your track',
    showSteps: 'Show the steps',
    hideSteps: 'Hide',
    why: 'Why ten minutes matters',
    whyBody:
      'Reading about agents is not using one. Until you have watched a model write something confidently wrong and then fixed it, the warnings in this course are just words.',
    tracks: [
      {
        id: 'browser',
        tag: 'No install · Free',
        name: 'In your browser',
        who: 'For a phone, or a computer you cannot install anything on.',
        mins: '5 min',
        steps: [
          { t: 'Open a free AI chat', d: 'claude.ai, chatgpt.com or gemini.google.com — the free tier is enough.' },
          { t: 'Ask for one complete file', d: 'Copy the prompt below: one self-contained HTML file runs with no setup.' },
          { t: 'Save it and open it', d: 'Save the code as countdown.html and double-click it.' },
          { t: 'Change one thing', d: 'Ask for one change — another colour, your own date, a sound at zero.' },
        ],
        prompt: `Write a complete, single-file HTML page that counts down to 1 January 2027.

Requirements:
- One file. All CSS and JavaScript inline. No external libraries.
- Big readable numbers: days, hours, minutes, seconds, updating every second.
- Dark background, works on a phone screen.
- Put my name at the top: <your name>

Return only the file contents, nothing else.`,
        done: 'You made a working page by describing it. That is vibe coding, in the original sense.',
      },
      {
        id: 'terminal',
        tag: 'Laptop · The real thing',
        name: 'A real coding agent',
        who: 'A laptop you can install on. The rest of the course builds on this track.',
        mins: '10 min',
        steps: [
          { t: 'Install Node', d: 'Take the LTS build from nodejs.org, then check that a version number prints.' },
          { t: 'Install a coding agent', d: 'This course uses Claude Code. Gemini CLI is free and works the same way.' },
          { t: 'Make an empty folder', d: 'Never point an agent at your whole computer — give it one small folder.' },
          { t: 'Start it and ask for something real', d: 'Type your request in plain language, then read which files it plans to create.' },
          { t: 'Read what it did', d: 'Ask it to explain its own work. An agent that explains its choices is one you can correct.' },
        ],
        prompt: `Build a single-page countdown site for a QairuHub event on 1 December 2026.

- Plain HTML, CSS and JavaScript. No framework, no build step.
- A big countdown, the event name, and a short description.
- Dark theme, mobile first.

Before you write anything: tell me what files you plan to create and why. Wait for me to say go.`,
        done: 'You ran a real agent, reviewed its plan and shipped a file. Lab 01 picks up here.',
      },
      {
        id: 'ship',
        tag: 'Bonus · Free',
        name: 'Put it on the internet',
        who: 'You finished a track above and want a link to send someone.',
        mins: '5 min',
        steps: [
          { t: 'Open a free host', d: 'app.netlify.com/drop or pages.cloudflare.com — neither needs a card for a small static site.' },
          { t: 'Drag your folder in', d: 'Rename your file to index.html first, then Netlify Drop hands you a URL.' },
          { t: 'Send the link', d: 'Now it is a thing other people can open, not a file on your laptop.' },
        ],
        prompt: null,
        done: 'Something you described in words is live at a URL. Module 12 covers how that works.',
      },
    ],
    stuckH: 'If it goes wrong',
    stuck: [
      { q: 'The code it gave me does not work.', a: 'Normal, not a failure. Paste the exact error back, with what you expected — the full text is the useful part, not your summary of it.' },
      { q: 'It keeps building something else.', a: 'Under-specified, not misunderstood. Add the constraint you had in your head but never typed. Module 07 is all about this.' },
      { q: 'I cannot pay for anything.', a: 'Gemini CLI has a free tier and the browser track costs nothing. The tools page lists every free option and its limits.' },
      { q: 'It wants to run a command. Is that safe?', a: 'Read the command first. If it deletes, force-pushes or touches anything outside your test folder, say no. Module 11 is the full rule.' },
    ],
    nextH: 'Now the rest will make sense',
    nextP: 'You have something that works, and probably something that did not work first time. That is the right place to start.',
    nextPath: 'Start the full path',
    nextTools: 'Compare every tool',
    copyLabel: 'Copy this prompt',
    copied: 'Copied',
    doneLabel: 'You are done when',
  },
  kk: {
    title: 'Алғашқы 10 минутың',
    desc: 'ЖИ-мен кодтауды қазір, тегін, кез келген құрылғыда байқаудың үш жолы. Бірін таңда да, істеп көр.',
    kicker: 'Осыдан баста · 10 минут',
    h1a: 'Оқуды қой.',
    h1b: 'Жаза баста.',
    lead: 'Мұны оқып үйрену мүмкін емес. Қолыңда барына сай жолды таңда, он минут бөл, кішкентай нақты дүние жаса. Сайттағы қалғанының бәрі содан кейін түсінікті болады.',
    pickTrack: 'Жолыңды таңда',
    showSteps: 'Қадамдарын көрсет',
    hideSteps: 'Жабу',
    why: 'Он минут неге маңызды',
    whyBody:
      'Agent туралы оқу мен agent-пен жұмыс істеу — екі бөлек нәрсе. Модель сенімді түрде қате жазғанын көріп, оны өзің түзетпейінше, курстағы ескертулер жай сөз болып қала береді.',
    tracks: [
      {
        id: 'browser',
        tag: 'Орнатпай · Тегін',
        name: 'Браузерде',
        who: 'Телефонға немесе бағдарлама орната алмайтын компьютерге арналған.',
        mins: '5 мин',
        steps: [
          { t: 'Тегін ЖИ чатын аш', d: 'claude.ai, chatgpt.com немесе gemini.google.com — тегін нұсқасы жетеді.' },
          { t: 'Бір толық файл сұра', d: 'Төмендегі prompt-ты көшір: бір файлдық HTML ешқандай дайындықсыз ашылады.' },
          { t: 'Сақта да, ашып көр', d: 'Кодты countdown.html деп сақта, файлды екі рет бас.' },
          { t: 'Бір нәрсесін өзгерт', d: 'Бір ғана өзгеріс сұра: басқа түс, өз күнің, нөлге жеткенде дыбыс.' },
        ],
        prompt: `2027 жылдың 1 қаңтарына дейін санайтын толық, бір файлдан тұратын HTML бет жаз.

Талаптар:
- Бір файл. Барлық CSS пен JavaScript ішінде. Сыртқы кітапхана жоқ.
- Ірі, оқуға ыңғайлы сандар: күн, сағат, минут, секунд — әр секунд сайын жаңарады.
- Қараңғы фон, телефон экранында жақсы көрінеді.
- Жоғарғы жағына менің атымды қой: <атың>

Тек файл мазмұнын қайтар, басқа ештеңе жазба.`,
        done: 'Сөзбен сипаттап, жұмыс істейтін бет жасадың. Бастапқы мағынасындағы vibe coding — осы.',
      },
      {
        id: 'terminal',
        tag: 'Ноутбук · Нағыз нұсқа',
        name: 'Нағыз coding agent',
        who: 'Бағдарлама орната алатын ноутбукке арналған. Курстың қалғаны осы жолға сүйенеді.',
        mins: '10 мин',
        steps: [
          { t: 'Node орнат', d: 'nodejs.org сайтынан LTS нұсқасын ал, сосын нұсқа нөмірі шыққанын тексер.' },
          { t: 'Coding agent орнат', d: 'Бұл курс Claude Code қолданады. Gemini CLI тегін әрі дәл солай жұмыс істейді.' },
          { t: 'Бос қалта жаса', d: 'Agent-ті ешқашан бүкіл компьютеріңе жіберме — бір ғана кішкентай қалта бер.' },
          { t: 'Іске қосып, нақты тапсырма бер', d: 'Сұрауыңды қарапайым тілмен жаз да, қандай файл жасамақ екенін оқы.' },
          { t: 'Не істегенін оқы', d: 'Өз жұмысын түсіндіруін сұра. Таңдауын түсіндіре алатын agent-ті түзете де аласың.' },
        ],
        prompt: `2026 жылдың 1 желтоқсанындағы QairuHub іс-шарасына арналған бір беттік countdown сайтын құрастыр.

- Таза HTML, CSS және JavaScript. Framework жоқ, build қадамы жоқ.
- Ірі countdown, іс-шара атауы және қысқа сипаттама.
- Қараңғы тақырып, алдымен мобильді.

Ештеңе жазбас бұрын: қандай файл жасамақ екеніңді және неге екенін айт. Мен «жарайды» дегенше күт.`,
        done: 'Нағыз agent-ті іске қостың, жоспарын оқыдың, файл шығардың. 01-практика осы жерден жалғасады.',
      },
      {
        id: 'ship',
        tag: 'Бонус · Тегін',
        name: 'Интернетке шығар',
        who: 'Жоғарыдағы жолды бітірдің, енді біреуге жіберетін сілтеме керек.',
        mins: '5 мин',
        steps: [
          { t: 'Тегін хостинг аш', d: 'app.netlify.com/drop немесе pages.cloudflare.com — шағын статикалық сайтқа карта керек емес.' },
          { t: 'Қалтаңды сүйреп апар', d: 'Алдымен файлды index.html деп ата, сосын Netlify Drop саған URL береді.' },
          { t: 'Сілтемені жібер', d: 'Енді ол ноутбугыңдағы файл емес, кез келген адам аша алатын дүние.' },
        ],
        prompt: null,
        done: 'Сөзбен сипаттаған дүниең енді URL-де тұр. 12-модуль оның қалай жұмыс істейтінін түсіндіреді.',
      },
    ],
    stuckH: 'Бірдеңе дұрыс болмаса',
    stuck: [
      { q: 'Берген коды жұмыс істемейді.', a: 'Бұл сәтсіздік емес, қалыпты жағдай. Қатенің дәл мәтінін және не күткеніңді жазып жібер — пайдалысы сол толық мәтін, өз сөзіңмен айтқаның емес.' },
      { q: 'Сұрағаным емес, басқа нәрсе жасап жатыр.', a: 'Түсінбей жатқан жоқ, сұрауың толық емес. Ойыңда бар, бірақ жазбаған шартты қос. 07-модуль түгелдей осы туралы.' },
      { q: 'Ештеңеге төлей алмаймын.', a: 'Gemini CLI тегін, ал браузер жолына мүлде ештеңе керек емес. Құралдар бетінде әр тегін нұсқа мен оның шектеуі жазылған.' },
      { q: 'Команда жүргізуді сұрады. Қауіпсіз бе?', a: 'Алдымен команданы оқы. Бірдеңе жойса, күштеп push жасаса, тест қалтаңнан тыс жерге тисе — жоқ де. 11-модуль осы ереженің толық нұсқасы.' },
    ],
    nextH: 'Енді қалғаны түсінікті болады',
    nextP: 'Қолыңда жұмыс істейтін нәрсе бар, бірінші реттен шықпаған бірдеңе де бар шығар. Бастауға керегі — дәл осы.',
    nextPath: 'Толық жолды бастау',
    nextTools: 'Барлық құралды салыстыру',
    copyLabel: 'Prompt-ты көшір',
    copied: 'Көшірілді',
    doneLabel: 'Аяқтадың деп есепте',
  },
}[lang];

const cmds: Record<string, { label: string; code: string }[]> = {
  terminal: [
    { label: 'check Node', code: 'node -v' },
    { label: 'Claude Code', code: 'npm install -g @anthropic-ai/claude-code' },
    { label: 'or Gemini CLI (free)', code: 'npm install -g @google/gemini-cli' },
    { label: 'a clean folder', code: 'mkdir countdown && cd countdown' },
    { label: 'start it', code: 'claude' },
  ],
};
---

<BaseLayout lang={lang} title={c.title} description={c.desc} image="/og/try.png">
  <section class="hero wrap">
    <p class="kicker">{c.kicker}</p>
    <h1>
      <span class="block">{c.h1a}</span>
      <span class="block accent">{c.h1b}</span>
    </h1>
    <p class="lead">{c.lead}</p>
  </section>

  <section class="wrap band" data-reveal>
    <div class="why">
      <p class="eyebrow">{c.why}</p>
      <p>{c.whyBody}</p>
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <p class="eyebrow">{c.pickTrack}</p>
    <div class="tracks">
      {
        c.tracks.map((tr, i) => (
          <article class="track" data-reveal style={`--i:${i}`}>
            <header>
              <span class="pill pill-act">{tr.tag}</span>
              <span class="mins">{tr.mins}</span>
            </header>
            <h2>{tr.name}</h2>
            <p class="who">{tr.who}</p>

            {/* Three columns of full step lists side by side read as a wall.
                The headings stay visible so the track is still scannable; the
                detail opens on the one you actually picked. */}
            <details class="steps-wrap">
              <summary>
                <span class="steps-open">{c.showSteps}</span>
                <span class="steps-close">{c.hideSteps}</span>
                <span class="steps-n">{tr.steps.length}</span>
              </summary>
              <ol class="steps">
                {tr.steps.map((s) => (
                  <li>
                    <span class="s-t">{s.t}</span>
                    <span class="s-d">{s.d}</span>
                  </li>
                ))}
              </ol>

            {
              cmds[tr.id] && (
                <div class="term">
                  <div class="term-bar">
                    <span class="term-dots"><i /><i /><i /></span>
                    <span>terminal</span>
                  </div>
                  <div class="term-body cmds">
                    {cmds[tr.id].map((cm) => (
                      <div class="cmd">
                        <code><span class="pr">$</span> {cm.code}</code>
                        <span class="cmt"># {cm.label}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }

            {
              tr.prompt && (
                <div class="promptbox" data-copy-root>
                  <div class="pb-bar">
                    <span class="pb-t">{c.copyLabel}</span>
                    <button type="button" class="btn btn-sm" data-copy data-copied={c.copied}>
                      ⧉
                    </button>
                  </div>
                  <pre>{tr.prompt}</pre>
                </div>
              )
            }

            </details>

            <p class="done"><span>{c.doneLabel}</span> {tr.done}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <h2 class="h2">{c.stuckH}</h2>
    <div class="stuck">
      {
        c.stuck.map((s) => (
          <details>
            <summary>{s.q}</summary>
            <p>{s.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap band" data-reveal>
    <div class="next">
      <h2 class="h2">{c.nextH}</h2>
      <p class="lead-sm">{c.nextP}</p>
      <div class="cta">
        <a class="btn btn-signal" href={href(lang, 'learn/the-tweet')}>{c.nextPath} →</a>
        <a class="btn" href={href(lang, 'tools')}>{c.nextTools}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The steps open on demand. Closed, a track card is four lines and the three
     tracks can be compared at a glance; open, it is the full walkthrough. */
  .steps-wrap { margin-top: 18px; }
  .steps-wrap > summary {
    display: flex; align-items: center; gap: 9px; cursor: pointer; list-style: none;
    padding: 9px 13px; border-radius: 999px; border: 1px solid var(--color-line);
    font: 500 12.5px/1 var(--font-sans); color: var(--color-muted); width: fit-content;
    transition: border-color 0.2s, color 0.2s;
  }
  .steps-wrap > summary::-webkit-details-marker { display: none; }
  .steps-wrap > summary:hover { color: #fff; border-color: var(--color-line-strong); }
  .steps-n { font: 500 11px/1 var(--font-mono); color: var(--color-faint); }
  .steps-close { display: none; }
  .steps-wrap[open] > summary .steps-open { display: none; }
  .steps-wrap[open] > summary .steps-close { display: inline; }
  .steps-wrap[open] > summary { margin-bottom: 4px; }

  .hero { padding: clamp(44px, 7.2vw, 77px) 0 0; }
  .kicker { margin: 0 0 20px; font: 500 12px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-signal-soft); }
  h1 { font-size: clamp(40px,8.46vw, 65px); font-weight: 300; letter-spacing: -0.045em; line-height: 0.98; }
  .block { display: block; }
  .accent { color: var(--color-signal-soft); }
  .lead { max-width: 60ch; margin: 28px 0 0; font-size: clamp(16px, 1.88vw, 17px); line-height: 1.6; color: var(--color-muted); }
  .lead-sm { max-width: 58ch; margin: 16px 0 0; font-size: 17px; color: var(--color-muted); }

  .band { padding: clamp(37px, 5.4vw, 60px) 0 0; }
  .h2 { font-size: clamp(25px, 3.76vw, 34px); font-weight: 350; }

  .why { padding: 24px 26px; border-radius: 20px; border-left: 3px solid var(--color-signal); background: rgb(43 127 255 / 0.08); }
  .why p { margin: 10px 0 0; font-size: 17px; line-height: 1.65; color: #fff; max-width: 62ch; }

  .tracks { display: grid; gap: 18px; margin-top: 28px; }
  .track { padding: 26px 24px; border-radius: 24px; border: 1px solid var(--color-line); background: var(--color-fill); }
  .track header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mins { font: 500 12px/1 var(--font-mono); color: var(--color-faint); }
  .track h2 { margin-top: 16px; font-size: clamp(23px, 2.82vw, 26px); font-weight: 400; }
  .who { margin: 8px 0 0; font-size: 15.5px; color: var(--color-muted); }

  .steps { list-style: none; counter-reset: s; margin: 22px 0 0; padding: 0; display: grid; gap: 14px; }
  .steps li { counter-increment: s; display: grid; gap: 3px; padding-left: 38px; position: relative; }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgb(43 127 255 / 0.5); background: rgb(43 127 255 / 0.12); font: 500 12px/1 var(--font-mono); color: var(--color-signal-soft); }
  .s-t { font-weight: 600; font-size: 16px; color: #fff; }
  .s-d { font-size: 15px; line-height: 1.55; color: var(--color-muted); }

  .term { margin-top: 20px; }
  .cmds { display: grid; gap: 7px; }
  .cmd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .cmd code { font-size: 13px; color: #fff; }
  .pr { color: var(--color-signal-soft); }
  .cmt { font-size: 12px; color: var(--color-faint); }

  .promptbox { margin-top: 18px; border-radius: 16px; border: 1px solid rgb(43 127 255 / 0.35); background: rgb(43 127 255 / 0.07); overflow: hidden; }
  .pb-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 10px 9px 16px; border-bottom: 1px solid var(--color-line); }
  .pb-t { font: 500 12px/1 var(--font-mono); color: var(--color-signal-soft); }
  .promptbox pre { margin: 0; padding: 16px; font: 400 13px/1.65 var(--font-mono); color: #cfe2ff; white-space: pre-wrap; overflow-x: auto; }

  .done { margin: 20px 0 0; padding: 14px 16px; border-radius: 14px; border: 1px solid rgb(72 213 151 / 0.35); background: rgb(72 213 151 / 0.08); font-size: 15px; line-height: 1.55; color: #fff; }
  .done span { display: block; font: 500 10.5px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ok); margin-bottom: 6px; }

  .stuck { display: grid; gap: 8px; margin-top: 24px; }
  .stuck details { border-radius: 16px; border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.03); }
  .stuck summary { padding: 16px 20px; cursor: pointer; font-weight: 500; font-size: 16.5px; color: #fff; list-style: none; }
