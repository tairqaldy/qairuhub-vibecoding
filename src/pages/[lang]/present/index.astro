---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/data/curriculum';
import { cycle } from '@/data/curriculum';
import { href } from '@/i18n/ui';
import CycleDiagram from '@/components/CycleDiagram.astro';

export const getStaticPaths = (() => [{ params: { lang: 'en' } }, { params: { lang: 'kk' } }]) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const c = {
  en: {
    title: 'Slides',
    desc: 'Presentation mode for teaching this masterclass live. Arrow keys to move, F for fullscreen.',
    help: 'Arrows or space to move · F for fullscreen · Esc to leave',
    slide: 'Slide',
  },
  kk: {
    title: 'Слайдтар',
    desc: 'Осы мастер-классты тірі өткізуге арналған презентация режимі. Жылжу үшін көрсеткілер, толық экран үшін F.',
    help: 'Жылжу — көрсеткілер немесе бос орын · Толық экран — F · Шығу — Esc',
    slide: 'Слайд',
  },
}[lang];

type Slide =
  | { kind: 'title'; k: string; t: string; s?: string }
  | { kind: 'big'; k: string; t: string; s?: string }
  | { kind: 'stat'; k: string; v: string; t: string; s: string }
  | { kind: 'list'; k: string; t: string; items: string[] }
  | { kind: 'quote'; t: string; s: string }
  /* the one idea of the whole session, said at the start and again at the end */
  | { kind: 'creed'; k: string; t: string; items: { t: string; s: string }[] }
  /* felt speed against measured speed, as two bars */
  | { kind: 'bars'; k: string; t: string; s: string; bars: { label: string; pct: number; real: boolean }[] }
  | { kind: 'ladder'; k: string; t: string; steps: { n: string; t: string; s: string }[] }
  /* stop talking, make the room talk to each other */
  | { kind: 'pair'; k: string; t: string; s: string; items: string[] }
  | { kind: 'cycle'; k: string; t: string; s: string }
  | { kind: 'do'; k: string; t: string; url: string; steps: string[] };

const slides: Record<Lang, Slide[]> = {
  en: [
    { kind: 'title', k: 'QairuHub', t: 'Vibecoding', s: 'From your first prompt to a team of agents' },
    {
      kind: 'creed',
      k: 'One idea, the whole session',
      t: 'Try it. Ask. Break it. Keep going.',
      items: [
        { t: 'Try it', s: 'Ten minutes with a real agent beats ten articles about one.' },
        { t: 'Ask', s: 'Out loud, in the chat, or to the person sitting next to you.' },
        { t: 'Break it', s: 'A build that fails teaches you more than one that works.' },
        { t: 'Keep going', s: 'The tools change every month. The habit is what you keep.' },
      ],
    },
    { kind: 'quote', t: 'There is a new kind of coding I call vibe coding', s: 'Andrej Karpathy · 2 February 2025' },
    { kind: 'big', k: 'What he meant', t: 'You stop reading the code.', s: 'Not "using AI to code". Specifically: not looking at what it produced.' },
    { kind: 'stat', k: 'The hype', v: '95%', t: 'of the code in a quarter of YC W25 startups was written by AI', s: 'Jared Friedman, YC · March 2025' },
    {
      kind: 'bars',
      k: 'The measurement',
      t: 'Experienced developers, real tasks, randomised.',
      s: 'METR · July 2025',
      bars: [
        { label: 'How much faster they felt', pct: 20, real: false },
        { label: 'How much slower they were', pct: 19, real: true },
      ],
    },
    { kind: 'big', k: 'The gap', t: 'Feeling fast and being fast are different things.', s: 'That gap is what this masterclass is about.' },
    {
      kind: 'ladder',
      k: 'Three modes',
      t: 'Where are you on this?',
      steps: [
        { n: '01', t: 'Vibe coding', s: 'You do not read it. Fine for throwaway work.' },
        { n: '02', t: 'AI-assisted', s: 'You review every diff before it lands.' },
        { n: '03', t: 'Agentic engineering', s: 'You write specs, supervise plans, verify results.' },
      ],
    },
    { kind: 'big', k: 'Act II', t: 'The loop', s: 'Nine steps. Every project you will ever build runs it.' },
    { kind: 'cycle', k: 'The loop', t: 'Nine steps, one circle', s: 'Idea, context, agent, code, repo, test, deploy, logs — and back to idea.' },
    { kind: 'list', k: 'The loop', t: 'Say them out loud', items: cycle.map((x) => `${x.n}. ${x.title.en} — ${x.hint.en}`) },
    { kind: 'big', k: 'Live', t: 'Let us build something', s: 'Idea → PRD → CLAUDE.md → plan mode → commit → deploy' },
    { kind: 'stat', k: 'Security', v: '45%', t: 'of AI-generated code introduced an OWASP Top 10 flaw', s: 'Veracode · 2025' },
    { kind: 'big', k: 'July 2025', t: 'An agent deleted a production database during a code freeze.', s: 'The freeze existed only as a sentence in a prompt.' },
    { kind: 'big', k: 'The lesson', t: 'A rule the agent can talk its way past is not a rule.', s: 'Enforce it in the permission layer, not in English.' },
    {
      kind: 'pair',
      k: 'Right now',
      t: 'Turn to the person next to you.',
      s: 'Two laptops beat one. Nobody learns this alone.',
      items: [
        'Say what you want to build. One sentence, out loud.',
        'Swap screens the moment either of you is stuck.',
        'If it runs on one machine, make it run on both.',
      ],
    },
    {
      kind: 'list',
      k: 'Act III',
      t: 'When one agent becomes several',
      items: [
        'Start with one. Most work never needs more.',
        'Parallelise only what is independent and verifiable.',
        'Every finding gets a second agent that tries to disprove it.',
      ],
    },
    { kind: 'big', k: 'This site', t: 'Built overnight by a team of agents.', s: 'Research, writing, Kazakh, fact-checking, deploy. One person directing.' },
    {
      kind: 'do',
      k: 'Your turn',
      t: 'Set up your machine. Now, not tonight.',
      url: 'vibecoding.qairuhub.com/en/try',
      steps: [
        'Install Node, then Claude Code.',
        'Open a folder. Run claude.',
        'Ask for one small thing. Read what it did.',
        'Break it on purpose. Fix it.',
        'Then start your own project, not a tutorial.',
      ],
    },
    { kind: 'title', k: 'That is the whole thing', t: 'Try it.', s: 'Ask. Break it. Keep going.' },
  ],
  kk: [
    { kind: 'title', k: 'QairuHub', t: 'Vibecoding', s: 'Алғашқы prompt-тан agent-тер командасына дейін' },
    {
      kind: 'creed',
      k: 'Бір ой, бүкіл сабақ бойы',
      t: 'Байқап көр. Сұра. Бұзып ал. Тоқтама.',
      items: [
        { t: 'Байқап көр', s: 'Нағыз agent-пен өткізген он минут ол туралы он мақаладан артық.' },
        { t: 'Сұра', s: 'Дауыстап, чатта немесе қасыңда отырған адамнан.' },
        { t: 'Бұзып ал', s: 'Құламаған build-тен гөрі құлағаны көбірек үйретеді.' },
        { t: 'Тоқтама', s: 'Құралдар ай сайын өзгереді. Саған қалатыны — дағды.' },
      ],
    },
    { kind: 'quote', t: 'There is a new kind of coding I call vibe coding', s: 'Andrej Karpathy · 2025 ж. 2 ақпан' },
    { kind: 'big', k: 'Ол не айтқысы келді', t: 'Сен кодты оқуды қоясың.', s: '«ЖИ-мен кодтау» емес. Дәл айтқанда: не шыққанын қарамау.' },
    { kind: 'stat', k: 'Дабыра', v: '95%', t: 'YC W25 стартаптарының төрттен бірінде кодты ЖИ жазған', s: 'Jared Friedman, YC · 2025 ж. наурыз' },
    {
      kind: 'bars',
      k: 'Өлшеу',
      t: 'Тәжірибелі әзірлеушілер, нақты тапсырмалар, кездейсоқ бөлу.',
      s: 'METR · 2025 ж. шілде',
      bars: [
        { label: 'Өздерін қанша жылдам сезінді', pct: 20, real: false },
        { label: 'Шын мәнінде қанша баяу болды', pct: 19, real: true },
      ],
    },
    { kind: 'big', k: 'Алшақтық', t: 'Жылдам сезіну мен жылдам болу — екі бөлек нәрсе.', s: 'Осы мастер-класс сол алшақтық туралы.' },
    {
      kind: 'ladder',
      k: 'Үш режим',
      t: 'Сен қай жердесің?',
      steps: [
        { n: '01', t: 'Vibe coding', s: 'Оқымайсың. Уақытша жұмысқа жарайды.' },
        { n: '02', t: 'ЖИ-көмекші', s: 'Әр diff-ті түскенге дейін тексересің.' },
        { n: '03', t: 'Agentic engineering', s: 'Спецификация жазасың, жоспарды қадағалайсың, нәтижені тексересің.' },
      ],
    },
    { kind: 'big', k: 'II бөлім', t: 'Цикл', s: 'Тоғыз қадам. Құрастыратын кез келген жобаң осымен жүреді.' },
    { kind: 'cycle', k: 'Цикл', t: 'Тоғыз қадам, бір шеңбер', s: 'Идея, контекст, agent, код, репозиторий, тест, deploy, логтар — және қайта идеяға.' },
    { kind: 'list', k: 'Цикл', t: 'Дауыстап айт', items: cycle.map((x) => `${x.n}. ${x.title.kk} — ${x.hint.kk}`) },
    { kind: 'big', k: 'Тікелей', t: 'Бірдеңе құрастырайық', s: 'Идея → PRD → CLAUDE.md → plan mode → commit → deploy' },
    { kind: 'stat', k: 'Қауіпсіздік', v: '45%', t: 'ЖИ жазған кодта OWASP Top 10 осалдығы болды', s: 'Veracode · 2025' },
    { kind: 'big', k: '2025 ж. шілде', t: 'Agent «код мұздатылған» кезде production дерекқорын жойды.', s: 'Ал «мұздату» тек prompt ішіндегі сөйлем болатын.' },
    { kind: 'big', k: 'Сабақ', t: 'Agent сөзбен айналып өте алатын ереже — ереже емес.', s: 'Оны ағылшын тілінде емес, рұқсат деңгейінде бекіт.' },
    {
      kind: 'pair',
      k: 'Дәл қазір',
      t: 'Қасыңда отырған адамға бұрыл.',
      s: 'Екі ноутбук біреуден артық. Мұны ешкім жалғыз үйренбейді.',
      items: [
        'Не құрастырғың келетінін айт. Бір сөйлеммен, дауыстап.',
        'Екеуіңнің бірі тұрып қалса — экранды бірден алмастыр.',
        'Бір құрылғыда жұмыс істесе, екіншісінде де істейтін қыл.',
      ],
    },
    {
      kind: 'list',
      k: 'III бөлім',
      t: 'Бір agent бірнешеуге айналғанда',
      items: [
        'Біреуден баста. Көп жұмысқа артығы керек емес.',
        'Тек тәуелсіз әрі тексеруге келетінін ғана қатарластыр.',
        'Әр табылған мәселеге оны теріске шығаратын екінші agent қой.',
      ],
    },
    { kind: 'big', k: 'Бұл сайт', t: 'Бір түнде agent-тер командасы құрастырған.', s: 'Зерттеу, мәтін, қазақша, тексеру, deploy. Басқарған — бір адам.' },
    {
      kind: 'do',
      k: 'Сенің кезегің',
      t: 'Құрылғыңды дайында. Кешке емес, дәл қазір.',
      url: 'vibecoding.qairuhub.com/kk/try',
      steps: [
        'Node орнат, сосын Claude Code.',
        'Қалта аш. claude пәрменін іске қос.',
        'Бір шағын нәрсе сұра. Не істегенін оқы.',
        'Әдейі бұзып көр. Сосын түзет.',
        'Сосын оқулық емес, өз жобаңды баста.',
      ],
    },
    { kind: 'title', k: 'Бар болғаны осы', t: 'Байқап көр.', s: 'Сұра. Бұзып ал. Тоқтама.' },
  ],
};

const deck = slides[lang];
// Courgette covers Latin only, so a Cyrillic headline must not use it.
const latin = (s: string) => !/[Ѐ-ӿ]/.test(s);
---

<BaseLayout lang={lang} title={c.title} description={c.desc} bare noindex>
  <div class="deck" data-deck>
    <div class="rail" aria-hidden="true"><span data-progress style="width:0%"></span></div>

    {
      deck.map((s, i) => (
        <section class="slide" id={String(i + 1)} data-slide={i} hidden={i !== 0}>
          <div class="inner">
            {s.kind === 'title' && (
              <>
                <p class="k">{s.k}</p>
                <h1 class:list={['head', { brand: latin(s.t) }]}>{s.t}</h1>
                {s.s && <p class="sub">{s.s}</p>}
              </>
            )}
            {s.kind === 'big' && (
              <>
                <p class="k">{s.k}</p>
                <h2>{s.t}</h2>
                {s.s && <p class="sub">{s.s}</p>}
              </>
            )}
            {s.kind === 'stat' && (
              <>
                <p class="k">{s.k}</p>
                <p class="v">{s.v}</p>
                <h2 class="small">{s.t}</h2>
                <p class="src">{s.s}</p>
              </>
            )}
            {s.kind === 'list' && (
              <>
                <p class="k">{s.k}</p>
                <h2 class="small">{s.t}</h2>
                <ul>
                  {s.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </>
            )}
            {s.kind === 'quote' && (
              <>
                <blockquote>{s.t}</blockquote>
                <p class="src">{s.s}</p>
              </>
            )}

            {s.kind === 'creed' && (
              <>
                <p class="k">{s.k}</p>
                <h2 class="small">{s.t}</h2>
                <div class="creed">
                  {s.items.map((it, n) => (
                    <div class="creed-card" style={`--n:${n}`}>
                      <svg class="creed-mark" viewBox="0 0 48 48" aria-hidden="true">
                        <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.45" />
                        <circle cx="24" cy="24" r={7 + n * 4} fill="currentColor" opacity={0.18 + n * 0.12} />
                      </svg>
                      <p class="creed-t">{it.t}</p>
                      <p class="creed-s">{it.s}</p>
                    </div>
                  ))}
                </div>
              </>
            )}

            {s.kind === 'bars' && (
              <>
                <p class="k">{s.k}</p>
                <h2 class="small">{s.t}</h2>
                <div class="bars">
                  {s.bars.map((b) => (
                    <div class="bar-row">
                      <p class="bar-label">{b.label}</p>
                      <div class="bar-track">
                        <span class:list={['bar-fill', { real: b.real }]} style={`width:${b.pct * 3.2}%`} />
                      </div>
                      <p class:list={['bar-val', { real: b.real }]}>{b.pct}%</p>
                    </div>
                  ))}
                </div>
                <p class="src">{s.s}</p>
              </>
            )}

            {s.kind === 'ladder' && (
              <>
                <p class="k">{s.k}</p>
                <h2 class="small">{s.t}</h2>
                <div class="ladder">
                  {s.steps.map((st, n) => (
                    <div class="rung" style={`--n:${n}`}>
                      <span class="rung-n">{st.n}</span>
                      <span class="rung-body">
                        <span class="rung-t">{st.t}</span>
                        <span class="rung-s">{st.s}</span>
                      </span>
                    </div>
                  ))}
                </div>
              </>
            )}

            {s.kind === 'pair' && (
              <>
                <p class="k">{s.k}</p>
                <div class="pair">
                  <div>
                    <h2 class="small">{s.t}</h2>
                    <p class="sub">{s.s}</p>
                    <ul>
                      {s.items.map((it) => (
                        <li>{it}</li>
                      ))}
                    </ul>
                  </div>
                  <svg class="pair-art" viewBox="0 0 240 200" aria-hidden="true">
                    <rect x="14" y="52" width="92" height="62" rx="7" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5" />
                    <rect x="134" y="52" width="92" height="62" rx="7" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5" />
                    <rect x="4" y="118" width="112" height="8" rx="4" fill="currentColor" opacity="0.22" />
                    <rect x="124" y="118" width="112" height="8" rx="4" fill="currentColor" opacity="0.22" />
                    <circle cx="60" cy="28" r="13" fill="currentColor" opacity="0.6" />
                    <circle cx="180" cy="28" r="13" fill="currentColor" opacity="0.6" />
                    <path d="M92 30 H148" stroke="currentColor" stroke-width="2" stroke-dasharray="5 6" opacity="0.7" />
                    <path d="M140 24 L150 30 L140 36" fill="none" stroke="currentColor" stroke-width="2" opacity="0.7" />
                    <path d="M100 36 L90 30 L100 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.7" />
                    <path d="M30 70 H80 M30 82 H92 M30 94 H64" stroke="currentColor" stroke-width="2" opacity="0.32" />
                    <path d="M150 70 H200 M150 82 H212 M150 94 H184" stroke="currentColor" stroke-width="2" opacity="0.32" />
                  </svg>
                </div>
              </>
            )}

            {s.kind === 'cycle' && (
              <>
                <p class="k">{s.k}</p>
                <div class="cyc">
                  <div>
                    <h2 class="small">{s.t}</h2>
                    <p class="sub">{s.s}</p>
                  </div>
                  <div class="cyc-art">
                    <CycleDiagram lang={lang} compact />
                  </div>
                </div>
              </>
            )}

            {s.kind === 'do' && (
              <>
                <p class="k">{s.k}</p>
                <h2 class="small">{s.t}</h2>
                <ol class="do">
                  {s.steps.map((st, n) => (
                    <li style={`--n:${n}`}>
                      <span class="do-n">{n + 1}</span>
                      {st}
                    </li>
                  ))}
                </ol>
                <p class="do-url">{s.url}</p>
              </>
            )}
          </div>
          <p class="num">
            {c.slide} {i + 1} / {deck.length}
          </p>
        </section>
      ))
    }

    <div class="controls no-print">
      <button type="button" data-prev aria-label="Previous">←</button>
      <button type="button" data-next aria-label="Next">→</button>
      <button type="button" data-full aria-label="Fullscreen">⛶</button>
      <a href={href(lang)} aria-label="Exit">✕</a>
    </div>
    <p class="help no-print">{c.help}</p>
  </div>
</BaseLayout>

<style>
  .deck { min-height: 100dvh; display: grid; place-items: center; position: relative; }
  .rail { position: fixed; top: 0; left: 0; right: 0; height: 3px; background: rgb(255 255 255 / 0.1); z-index: 5; }
  .rail span { display: block; height: 100%; background: var(--color-signal); transition: width 0.4s var(--ease-out-expo); }
  .slide { width: min(1100px, 100% - 48px); min-height: 100dvh; display: grid; align-content: center; padding: 80px 0; }
  .slide[hidden] { display: none; }
  .inner > * { animation: rise 0.6s var(--ease-out-expo) both; }
  .inner > :nth-child(2) { animation-delay: 80ms; }
  .inner > :nth-child(3) { animation-delay: 160ms; }
  .inner > :nth-child(4) { animation-delay: 240ms; }
  .k { margin: 0 0 24px; font: 500 13px/1 var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-signal-soft); }
  .brand { font-family: var(--font-brand); font-weight: 400; font-size: clamp(56px, 13vw, 150px); line-height: 1.05; color: #fff; letter-spacing: -0.01em; }
  h1, h2 { font-size: clamp(38px, 7.5vw, 86px); font-weight: 300; letter-spacing: -0.04em; line-height: 1.02; }
  h2.small { font-size: clamp(28px, 4.6vw, 52px); }
  .sub { margin: 28px 0 0; max-width: 46ch; font-size: clamp(18px, 2.4vw, 26px); line-height: 1.45; color: var(--color-muted); }
  .v { margin: 0 0 14px; font: 200 clamp(90px, 19vw, 230px)/0.85 var(--font-display); letter-spacing: -0.05em; color: var(--color-signal-soft); }
  .src { margin: 22px 0 0; font: 400 14px/1.4 var(--font-mono); color: var(--color-faint); }
  blockquote { margin: 0; padding-left: 28px; border-left: 4px solid var(--color-signal); font-size: clamp(30px, 5.4vw, 64px); font-weight: 300; line-height: 1.18; letter-spacing: -0.03em; color: #fff; }
  ul { margin: 34px 0 0; padding: 0; list-style: none; display: grid; gap: 18px; max-width: 30ch; }
  ul li { padding-left: 30px; position: relative; font-size: clamp(18px, 2.3vw, 25px); line-height: 1.4; color: rgb(255 255 255 / 0.9); }
  ul li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 14px; height: 2px; background: var(--color-signal); }

  /* the one idea — four cards that grow, left to right */
  .creed { display: grid; gap: 14px; margin-top: 40px; }
  .creed-card { padding: 22px 20px; border-radius: 20px; border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.035);
                color: var(--color-signal-soft); animation: rise 0.5s var(--ease-out-expo) both; animation-delay: calc(var(--n) * 90ms + 200ms); }
  .creed-mark { width: 38px; height: 38px; display: block; }
  .creed-t { margin: 16px 0 0; font: 400 clamp(21px, 2.6vw, 30px)/1.1 var(--font-display); letter-spacing: -0.02em; color: #fff; }
  .creed-s { margin: 9px 0 0; font-size: clamp(14.5px, 1.5vw, 17px); line-height: 1.5; color: var(--color-muted); }

  /* felt speed against measured speed */
  .bars { display: grid; gap: 26px; margin-top: 44px; }
  .bar-row { display: grid; grid-template-columns: 1fr auto; gap: 8px 16px; align-items: center; }
  .bar-label { grid-column: 1 / -1; margin: 0; font-size: clamp(15px, 1.8vw, 20px); color: var(--color-muted); }
  .bar-track { height: 26px; border-radius: 13px; background: rgb(255 255 255 / 0.07); overflow: hidden; }
  .bar-fill { display: block; height: 100%; border-radius: 13px; background: var(--color-signal);
              animation: grow 0.9s var(--ease-out-expo) both; animation-delay: 260ms; transform-origin: left; }
  .bar-fill.real { background: var(--color-pink); }
  .bar-val { margin: 0; font: 300 clamp(26px, 3.4vw, 42px)/1 var(--font-display); color: var(--color-signal-soft); }
  .bar-val.real { color: var(--color-pink); }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* three modes as rungs that step up */
  .ladder { display: grid; gap: 12px; margin-top: 40px; }
  .rung { display: flex; align-items: flex-start; gap: 18px; padding: 20px 22px; border-radius: 18px;
          border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.035);
          margin-left: calc(var(--n) * 4%); animation: rise 0.5s var(--ease-out-expo) both; animation-delay: calc(var(--n) * 110ms + 200ms); }
  .rung-n { flex: none; font: 500 14px/1.6 var(--font-mono); color: var(--color-signal-soft); }
  .rung-body { display: grid; gap: 5px; }
  .rung-t { font: 400 clamp(21px, 2.7vw, 32px)/1.1 var(--font-display); letter-spacing: -0.02em; color: #fff; }
  .rung-s { font-size: clamp(14.5px, 1.6vw, 18px); line-height: 1.45; color: var(--color-muted); }

  /* make the room talk to each other */
  .pair { display: grid; gap: 30px; align-items: center; color: var(--color-signal-soft); }
  .pair ul { max-width: 34ch; }
  .pair-art { width: 100%; max-width: 380px; justify-self: center; }

  .cyc { display: grid; gap: 30px; align-items: center; }
  .cyc-art { justify-self: center; width: 100%; max-width: 560px; }

  /* do it now */
  .do { margin: 38px 0 0; padding: 0; list-style: none; display: grid; gap: 14px; max-width: 34ch; }
  .do li { display: flex; align-items: baseline; gap: 14px; font-size: clamp(17px, 2.1vw, 24px); line-height: 1.35; color: rgb(255 255 255 / 0.92);
           animation: rise 0.45s var(--ease-out-expo) both; animation-delay: calc(var(--n) * 80ms + 160ms); }
  .do-n { flex: none; display: grid; place-items: center; width: 27px; height: 27px; border-radius: 50%;
          background: var(--color-signal); color: #fff; font: 500 13px/1 var(--font-mono); }
  .do-url { margin: 34px 0 0; font: 400 clamp(15px, 2vw, 22px)/1 var(--font-mono); color: var(--color-lime); }

  .num { position: fixed; top: 26px; right: 26px; margin: 0; font: 400 12px/1 var(--font-mono); color: var(--color-faint); }
  .controls { position: fixed; right: 20px; bottom: 20px; display: flex; gap: 8px; z-index: 6; }
  .controls button, .controls a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--color-line-strong); background: rgb(8 12 32 / 0.8); color: #fff; font-size: 15px; cursor: pointer; text-decoration: none; backdrop-filter: blur(8px); }
  .controls button:hover, .controls a:hover { background: var(--color-signal); border-color: transparent; }
  .help { position: fixed; left: 20px; bottom: 26px; margin: 0; font: 400 11.5px/1 var(--font-mono); color: var(--color-faint); }
  @media (max-width: 640px) { .help { display: none; } }

  @media (min-width: 900px) {
    .creed { grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .pair, .cyc { grid-template-columns: 1.05fr 0.95fr; gap: 48px; }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  let i = Math.max(0, Math.min(slides.length - 1, Number(location.hash.slice(1)) - 1 || 0));

  function show(n: number) {
    i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach((s, k) => (s.hidden = k !== i));
    if (bar) bar.style.width = `${((i + 1) / slides.length) * 100}%`;
    history.replaceState(null, '', `#${i + 1}`);
  }

  show(i);

  // Jumping by URL and the browser Back button should both move the deck —
  // a hash-only change does not reload the page, so nothing would happen.
  window.addEventListener('hashchange', () => {
    const n = Number(location.hash.slice(1));
    if (Number.isFinite(n) && n >= 1 && n - 1 !== i) show(n - 1);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
      e.preventDefault();
      show(i + 1);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      show(i - 1);
    } else if (e.key.toLowerCase() === 'f') {
      document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
    } else if (e.key === 'Home') show(0);
    else if (e.key === 'End') show(slides.length - 1);
  });

  document.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
  document.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
  document
    .querySelector('[data-full]')
    ?.addEventListener('click', () =>
      document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen(),
    );

  // swipe on touch devices
  let x0 = 0;
  document.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  document.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 60) show(i + (dx < 0 ? 1 : -1));
    },
    { passive: true },
  );
</script>
