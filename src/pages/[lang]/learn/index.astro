---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/data/curriculum';
import { acts, modules, totalXp } from '@/data/curriculum';
import { href, useT } from '@/i18n/ui';
import Certificate from '@/components/widgets/Certificate';
import CycleDiagram from '@/components/CycleDiagram.astro';

export const getStaticPaths = (() => [{ params: { lang: 'en' } }, { params: { lang: 'kk' } }]) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };
const t = useT(lang);

const c = {
  en: {
    title: 'The path',
    desc: 'Sixteen modules, from what vibe coding means to running several agents at once.',
    kicker: 'The path · 16 modules',
    h1: 'The path',
    lead: 'Read them in order the first time. Each module is eight to twelve minutes, ends with something you do, and leaves you one thing you can reuse.',
    resume: 'Continue where you left off',
    startFirst: 'Start with module 00',
    totalTime: 'about 2 hours 30 minutes total',
    yourXp: 'your XP',
    step: 'Cycle step',
    cardK: 'Your card',
    cycleK: 'Act II, step by step',
    cycleH: 'One loop, nine steps',
    cycleP: 'Idea, context, agent, code, repo, test, deploy, logs, back to idea. Act II walks it once, slowly, building a real sign-up app.',
  },
  kk: {
    title: 'Жол',
    desc: 'Он алты модуль: vibe coding дегеннен бастап, бірнеше agent-ті қатар басқаруға дейін.',
    kicker: 'Жол · 16 модуль',
    h1: 'Жол',
    lead: 'Алғаш оқығанда ретімен жүр. Әр модуль — сегіз-он екі минут. Соңында өзің істейтін тапсырма және қайта қолданатын бір нәрсе қалады.',
    resume: 'Тоқтаған жеріңнен жалғастыру',
    startFirst: '00-модульден бастау',
    totalTime: 'бәріне шамамен 2 сағат 30 минут',
    yourXp: 'сенің XP',
    step: 'Цикл қадамы',
    cardK: 'Сенің картаң',
    cycleK: 'II бөлім, қадам-қадаммен',
    cycleH: 'Бір цикл, тоғыз қадам',
    cycleP: 'Идея, контекст, agent, код, репозиторий, тест, deploy, логтар — қайта идеяға. II бөлім осы циклді бір рет, асықпай жүріп өтеді. Соңында нақты тіркелу қолданбасы шығады.',
  },
}[lang];
---

<BaseLayout lang={lang} title={c.title} description={c.desc} image="/og/learn.png">
  <section class="hero wrap">
    <p class="kicker">{c.kicker}</p>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <div class="bar-wrap">
      <div class="bar"><span data-bar style="width:0%"></span></div>
      <p class="meta">
        <b data-done>0</b>/{modules.length} · <b data-xp>0</b>/{totalXp} {c.yourXp} · {c.totalTime}
      </p>
    </div>
    <div class="cta">
      <a class="btn btn-signal" href={href(lang, 'learn/the-tweet')} data-resume>{c.startFirst} →</a>
    </div>
  </section>

  {
    acts.map((act) => (
      <section class="wrap band" data-act={act.id} data-reveal>
        <header class="act-head">
          <span class="act-n">{act.n}</span>
          <div>
            <h2>{act.title[lang]}</h2>
            <p>{act.tagline[lang]}</p>
          </div>
        </header>
        <ol class="mods">
          {modules
            .filter((m) => m.act === act.id)
            .map((m, i) => (
              <li data-reveal style={`--i:${i}`}>
                <a href={href(lang, `learn/${m.slug}`)} data-mod={m.slug}>
                  <span class="n">{String(m.order).padStart(2, '0')}</span>
                  <span class="body">
                    <span class="t">{m.title[lang]}</span>
                    <span class="b">{m.blurb[lang]}</span>
                    <span class="tags">
                      <span class="tag">{m.minutes} {t('lesson.minutes')}</span>
                      <span class="tag">+{m.xp} XP</span>
                      {m.cycleStep && <span class="tag">{c.step} {m.cycleStep}/9</span>}
                    </span>
                  </span>
                  <span class="check" aria-hidden="true">✓</span>
                </a>
              </li>
            ))}
        </ol>
      </section>
    ))
  }

  <section class="wrap band" data-reveal>
    <p class="eyebrow">{c.cycleK}</p>
    <h2 class="cycle-h">{c.cycleH}</h2>
    <p class="cycle-p">{c.cycleP}</p>
    <div class="cycle-wrap"><CycleDiagram lang={lang} /></div>
  </section>

  <section class="wrap band" data-reveal>
    <p class="eyebrow"><b>★</b> {c.cardK}</p>
    <Certificate client:visible lang={lang} />
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(44px, 7.2vw, 74px) 0 0; }
  .kicker { margin: 0 0 18px; font: 500 12px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-signal-soft); }
  h1 { font-size: clamp(42px,8.46vw, 68px); font-weight: 300; letter-spacing: -0.045em; }
  .lead { max-width: 62ch; margin: 24px 0 0; font-size: clamp(16px, 1.88vw, 16px); line-height: 1.65; color: var(--color-muted); }
  .bar-wrap { margin-top: 32px; max-width: 520px; }
  .bar { height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.12); overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--color-signal); transition: width 0.7s var(--ease-out-expo); }
  .meta { margin: 10px 0 0; font: 400 12.5px/1.4 var(--font-mono); color: var(--color-faint); }
  .meta b { color: #fff; font-weight: 500; }
  .cta { margin-top: 26px; }

  .band { padding: clamp(40px, 5.4vw, 60px) 0 0; }
  .act-head { display: flex; align-items: flex-start; gap: 16px; }
  .act-n { display: grid; place-items: center; width: 38px; height: 38px; flex: none; border-radius: 10px; background: color-mix(in oklab, var(--act) 20%, transparent); color: var(--act); font: 500 15px/1 var(--font-mono); }
  .act-head h2 { font-size: clamp(27px, 3.76vw, 34px); font-weight: 350; }
  .act-head p { margin: 6px 0 0; font-size: 16px; color: var(--color-muted); }

  .mods { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 8px; }
  .mods a { display: flex; align-items: flex-start; gap: 16px; padding: 20px 22px; border-radius: 18px; border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.03); text-decoration: none; color: inherit; transition: border-color 0.3s, background 0.3s, transform 0.4s var(--ease-out-expo); }
  .mods a:hover { border-color: color-mix(in oklab, var(--act) 55%, transparent); background: var(--color-fill-hover); transform: translateX(4px); }
  .n { font: 500 13px/1.5 var(--font-mono); color: var(--act); flex: none; }
  .body { display: grid; gap: 5px; min-width: 0; }
  .t { font: 400 20px/1.25 var(--font-display); letter-spacing: -0.02em; color: #fff; }
  .b { font-size: 15px; line-height: 1.5; color: var(--color-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .tag { padding: 3px 9px; border-radius: 999px; border: 1px solid var(--color-line); font: 400 11px/1.4 var(--font-mono); color: var(--color-faint); }
  .check { margin-left: auto; display: grid; place-items: center; width: 24px; height: 24px; flex: none; border-radius: 50%; border: 1px solid var(--color-line-strong); font-size: 12px; color: transparent; transition: all 0.3s; }
  .mods a.is-done .check { background: var(--act); border-color: var(--act); color: #fff; }
  .mods a.is-done .t { color: var(--color-muted); }
  .cycle-h { margin-top: 14px; font-size: clamp(25px, 3.76vw, 34px); font-weight: 350; }
  .cycle-p { max-width: 62ch; margin: 16px 0 0; font-size: 17px; line-height: 1.6; color: var(--color-muted); }
  .cycle-wrap { margin-top: 36px; }
</style>

<script>
  const KEY = 'vc:progress:v1';
  function paint() {
    let earned: Record<string, number> = {};
    try {
      earned = JSON.parse(localStorage.getItem(KEY) || '{}').earned ?? {};
    } catch {}
    const xp = Object.values(earned).reduce((a: number, b) => a + (b as number), 0);
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-mod]');
    let done = 0;
    let firstUndone: HTMLAnchorElement | null = null;
    links.forEach((a) => {
      const ok = `module:${a.dataset.mod}` in earned;
      a.classList.toggle('is-done', ok);
      if (ok) done++;
      else if (!firstUndone) firstUndone = a;
    });
    const bar = document.querySelector<HTMLElement>('[data-bar]');
    const d = document.querySelector<HTMLElement>('[data-done]');
    const x = document.querySelector<HTMLElement>('[data-xp]');
    if (bar && links.length) bar.style.width = `${(done / links.length) * 100}%`;
    if (d) d.textContent = String(done);
    if (x) x.textContent = String(xp);

    // point the main button at the first module the reader has not finished
    const resume = document.querySelector<HTMLAnchorElement>('[data-resume]');
    if (resume && done > 0 && firstUndone) {
      resume.href = (firstUndone as HTMLAnchorElement).href;
      resume.textContent = resume.dataset.resumeLabel || resume.textContent;
    }
  }
  paint();
  window.addEventListener('vc:progress', paint);
</script>
