---
// A prompt the learner copies into their agent. Put a fenced ```text block inside.
import { langFromUrl, useT } from '@/i18n/ui';

interface Props {
  title?: string;
  /** where to paste it, e.g. "Claude Code · plan mode" */
  where?: string;
}
const t = useT(langFromUrl(Astro.url));
const { title = 'Prompt', where } = Astro.props;
---

<div class="prompt" data-copy-root>
  <div class="bar">
    <span class="title"><span class="glyph" aria-hidden="true">❯</span>{title}</span>
    {where && <span class="where">{where}</span>}
    <button type="button" class="copy" data-copy data-copied={t('cta.copied')}>{t('cta.copy')}</button>
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .prompt { margin: 32px 0; border-radius: 18px; border: 1px solid color-mix(in oklab, var(--color-signal) 35%, transparent); background: linear-gradient(180deg, rgb(43 127 255 / 0.06), rgb(43 127 255 / 0.01)); overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 12px; padding: 10px 12px 10px 18px; border-bottom: 1px solid var(--color-line); }
  .title { display: flex; align-items: center; gap: 8px; font: 500 13px/1.2 var(--font-mono); color: var(--color-signal); }
  .glyph { font-weight: 700; }
  .where { font: 400 12px/1.2 var(--font-mono); color: var(--color-faint); }
  .copy { margin-left: auto; min-height: 30px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--color-line-strong); background: rgb(255 255 255 / 0.05); color: #fff; font: 500 12px/1 var(--font-mono); cursor: pointer; transition: background 0.2s, border-color 0.2s; }
  .copy:hover { background: rgb(255 255 255 / 0.12); }
  .copy.done { border-color: var(--color-signal); color: var(--color-signal); }
  .body :global(pre) { margin: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; padding: 18px !important; white-space: pre-wrap !important; font-size: 14px !important; color: #e9efd6; }
  .body :global(pre code), .body :global(pre span) { color: inherit !important; white-space: pre-wrap !important; }
</style>
