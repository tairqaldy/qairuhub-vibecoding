---
import { langFromUrl, useT } from '@/i18n/ui';

interface Props {
  title?: string;
}
const t = useT(langFromUrl(Astro.url));
const { title } = Astro.props;
---

<details class="deeper">
  <summary>
    <span class="plus" aria-hidden="true"></span>
    <span class="k">{t('lesson.goDeeper')}</span>
    {title && <span class="t">{title}</span>}
  </summary>
  <div class="in"><slot /></div>
</details>

<style>
  .deeper { margin: 28px 0; border-radius: 16px; border: 1px dashed var(--color-line-strong); background: rgb(255 255 255 / 0.02); }
  summary { display: flex; align-items: center; gap: 12px; padding: 14px 18px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; width: 14px; height: 14px; flex: none; }
  .plus::before, .plus::after { content: ''; position: absolute; inset: 6px 0; background: var(--color-ice); transition: transform 0.3s var(--ease-out-expo); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  .k { font: 500 12px/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ice); white-space: nowrap; }
  .t { font-weight: 500; color: #fff; font-size: 16px; }
  .in { padding: 4px 18px 20px 44px; font-size: 16px; color: #cfd4ee; }
  .in > :global(* + *) { margin-top: 1em; }
  .in > :global(:first-child) { margin-top: 0; }
</style>
