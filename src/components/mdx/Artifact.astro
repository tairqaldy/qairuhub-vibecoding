---
// The takeaway of a module: a template, checklist or cheat sheet. href points into /templates/… or an anchor.
import { langFromUrl, useT } from '@/i18n/ui';

interface Props {
  title: string;
  href?: string;
  kind?: 'template' | 'checklist' | 'cheatsheet' | 'prompt-pack';
}
const t = useT(langFromUrl(Astro.url));
const { title, href, kind = 'template' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="artifact" href={href} {...href?.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}} data-reveal>
  <span class="ico" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 3h7l5 5v13H7z" /><path d="M14 3v5h5M10 13h6M10 17h6" /></svg>
  </span>
  <span class="txt">
    <span class="k">{t('lesson.artifact')} · {kind}</span>
    <span class="t">{title}</span>
    <span class="d"><slot /></span>
  </span>
  {href && <span class="go" aria-hidden="true">→</span>}
</Tag>

<style>
  .artifact { display: flex; align-items: center; gap: 18px; margin: 40px 0; padding: 20px 22px; border-radius: 20px; border: 1px solid var(--color-line-strong); background: linear-gradient(90deg, rgb(124 212 255 / 0.08), transparent 60%); text-decoration: none !important; color: inherit !important; transition: border-color 0.3s, transform 0.5s var(--ease-out-expo); }
  a.artifact:hover { border-color: var(--color-ice); transform: translateY(-3px); }
  .ico { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 14px; background: rgb(124 212 255 / 0.12); color: var(--color-ice); }
  .txt { display: grid; gap: 3px; min-width: 0; }
  .k { font: 500 11px/1.2 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ice); }
  .t { font: 450 19px/1.3 var(--font-display); color: #fff; }
  .d { font-size: 14.5px; color: var(--color-muted); }
  .go { margin-left: auto; font-size: 22px; color: var(--color-ice); transition: transform 0.4s var(--ease-out-expo); }
  a.artifact:hover .go { transform: translateX(5px); }
</style>
