---
interface Props {
  title: string;
  date?: string;
  place?: string;
}
const { title, date, place } = Astro.props;
---

<section class="story" data-reveal>
  <header>
    <span class="tag">{[date, place].filter(Boolean).join(' · ') || 'Story'}</span>
    <h3>{title}</h3>
  </header>
  <div class="body"><slot /></div>
</section>

<style>
  .story { position: relative; margin: 44px 0; padding: 28px 24px 28px 30px; border-radius: 22px; border: 1px solid color-mix(in oklab, var(--color-amber) 30%, transparent); background: linear-gradient(135deg, rgb(255 181 71 / 0.09), rgb(255 181 71 / 0.02) 55%); }
  .story::before { content: ''; position: absolute; left: 0; top: 26px; bottom: 26px; width: 3px; border-radius: 3px; background: var(--color-amber); }
  .tag { font: 500 12px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-amber); }
  h3 { margin: 10px 0 0 !important; font-size: clamp(21px, 2.82vw, 26px) !important; font-weight: 350 !important; }
  .body { margin-top: 14px; }
  .body > :global(* + *) { margin-top: 1em; }
</style>
