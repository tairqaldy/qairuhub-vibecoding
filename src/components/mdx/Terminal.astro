---
// A terminal window. Put a fenced ```bash (commands) or ```text (session output) block inside.
import { langFromUrl, useT } from '@/i18n/ui';

interface Props {
  title?: string;
  /** set false for output-only blocks where copying makes no sense */
  copy?: boolean;
}
const t = useT(langFromUrl(Astro.url));
const { title = 'terminal', copy = true } = Astro.props;
---

<div class="term" data-copy-root>
  <div class="term-bar">
    <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>{title}</span>
    {copy && <button type="button" class="copy" data-copy data-copied={t('cta.copied')}>{t('cta.copy')}</button>}
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .term { margin: 32px 0; }
  .copy { margin-left: auto; min-height: 26px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--color-line-strong); background: transparent; color: var(--color-muted); font: 500 11px/1 var(--font-mono); cursor: pointer; transition: color 0.2s, border-color 0.2s; }
  .copy:hover { color: #fff; }
  .copy.done { border-color: var(--color-signal); color: var(--color-signal); }
  .body :global(pre) { margin: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; }
</style>
