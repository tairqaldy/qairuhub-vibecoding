---
import type { Lang } from '@/data/curriculum';
import { totalXp } from '@/data/curriculum';
import { href, languages, switchLang, useT, type UiKey } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = Astro.url.pathname;

// `admin` links are rendered hidden and revealed by JS for the organiser only.
// The edge gate is what actually enforces this; hiding them just keeps the nav
// honest for everyone else.
const links: { key: UiKey; to: string; admin?: boolean }[] = [
  { key: 'nav.try', to: 'try' },
  { key: 'nav.learn', to: 'learn' },
  { key: 'nav.labs', to: 'labs' },
  { key: 'nav.tools', to: 'tools' },
  { key: 'nav.materials', to: 'materials' },
  { key: 'nav.workshop', to: 'workshop', admin: true },
];
const isActive = (to: string) => path.startsWith(href(lang, to));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href(lang)} aria-label="Vibecoding — QairuHub">
      <span class="brand-mark">vibecoding</span>
      <span class="brand-by">by qairuhub</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={href(lang, l.to)}
            aria-current={isActive(l.to) ? 'page' : undefined}
            data-admin-only={l.admin ? '' : undefined}
            hidden={l.admin}
          >
            {t(l.key)}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <a class="xp" href={href(lang, 'learn')} title={t('progress.yourProgress')}>
        <span class="xp-dot" aria-hidden="true"></span>
        <span data-xp-value>0</span>
        <span class="xp-total">/ {totalXp} {t('progress.xp')}</span>
      </a>
      <a class="acct" href={href(lang, 'login')} data-acct hidden>
        <span class="acct-dot" aria-hidden="true"></span>
        <span data-acct-name>{t('auth.account')}</span>
      </a>
      <a class="btn btn-sm btn-signal signin" href={href(lang, 'login')} data-signin hidden>{t('auth.signIn')}</a>
      <div class="lang" role="group" aria-label={t('nav.language')}>
        {
          (Object.keys(languages) as Lang[]).map((l) => (
            <a
              href={switchLang(path, l)}
              hreflang={languages[l].htmlLang}
              lang={languages[l].htmlLang}
              aria-current={l === lang ? 'true' : undefined}
              data-set-lang={l}
            >
              {languages[l].short}
            </a>
          ))
        }
      </div>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('nav.menu')}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Mobile" hidden>
    {
      links.map((l, i) => (
        <a
          href={href(lang, l.to)}
          style={`--i:${i}`}
          aria-current={isActive(l.to) ? 'page' : undefined}
          data-admin-only={l.admin ? '' : undefined}
          hidden={l.admin}
        >
          {t(l.key)}
        </a>
      ))
    }
    <a href={href(lang, 'glossary')} style="--i:6">{t('nav.glossary')}</a>
    <a href={href(lang, 'present')} style="--i:7" data-admin-only hidden>{t('nav.present')}</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px) saturate(140%);
    background: linear-gradient(180deg, rgb(3 4 12 / 0.88), rgb(3 4 12 / 0.6));
    border-bottom: 1px solid var(--color-line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: var(--header-h); }
  .brand { display: flex; align-items: baseline; gap: 8px; text-decoration: none; margin-right: auto; }
  .brand-mark { font-family: var(--font-script); font-weight: 700; font-size: 30px; line-height: 1; color: #fff; letter-spacing: 0.01em; }
  .brand-by { display: none; font: 500 11px/1 var(--font-mono); color: var(--color-faint); letter-spacing: 0.08em; white-space: nowrap; }
  @media (min-width: 420px) { .brand-by { display: inline; } }
  .nav-desktop { display: none; gap: 4px; }
  .nav-desktop a { white-space: nowrap; padding: 8px 12px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; color: var(--color-muted); transition: color 0.2s, background 0.2s; }
  .nav-desktop a:hover { color: #fff; background: rgb(255 255 255 / 0.06); }
  .nav-desktop a[aria-current='page'] { color: #fff; background: rgb(255 255 255 / 0.09); }
  .tools { display: flex; align-items: center; gap: 10px; }
  .xp { display: none; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--color-line); text-decoration: none; font: 500 12px/1 var(--font-mono); color: #fff; }
  .xp-total { color: var(--color-faint); }
  .xp-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-signal); box-shadow: 0 0 10px var(--color-signal); }
  .xp.bump .xp-dot { animation: pulse-ring 0.9s ease-out; }
  .acct { display: none; align-items: center; gap: 7px; padding: 7px 13px; border-radius: 999px; border: 1px solid var(--color-line-strong); text-decoration: none; font: 500 13px/1 var(--font-sans); color: #fff; max-width: 150px; }
  .acct:hover { background: var(--color-fill-hover); }
  .acct[hidden] { display: none !important; }
  .acct span[data-acct-name] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .acct-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--color-ok); }
  .signin[hidden] { display: none !important; }
  @media (min-width: 640px) { .acct:not([hidden]) { display: inline-flex; } }
  .lang { display: flex; padding: 3px; border-radius: 999px; border: 1px solid var(--color-line-strong); }
  .lang a { padding: 6px 11px; border-radius: 999px; font: 600 12px/1 var(--font-sans); text-decoration: none; color: var(--color-muted); transition: color 0.2s; }
  .lang a:hover { color: #fff; }
  .lang a[aria-current='true'] { background: #fff; color: var(--color-ink); }
  .burger { display: grid; place-content: center; gap: 6px; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--color-line-strong); background: transparent; cursor: pointer; }
  .burger span { display: block; width: 16px; height: 1.5px; background: #fff; transition: transform 0.3s var(--ease-out-expo); }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .nav-mobile { display: grid; padding: 8px 20px 24px; border-top: 1px solid var(--color-line); }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile a { padding: 14px 4px; font: 350 26px/1.2 var(--font-display); text-decoration: none; color: #fff; border-bottom: 1px solid var(--color-line); animation: rise 0.5s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 45ms); }
  .nav-mobile a[aria-current='page'] { color: var(--color-signal); }
  @media (min-width: 560px) { .xp { display: inline-flex; } }
  @media (min-width: 1040px) {
    .nav-desktop { display: flex; }
    .burger, .nav-mobile { display: none !important; }
    .brand { margin-right: 24px; }
    .tools { margin-left: auto; }
  }
</style>

<script>
  const KEY = 'vc:progress:v1';
  const el = document.querySelector<HTMLElement>('[data-xp-value]');
  const chip = document.querySelector<HTMLElement>('.xp');
  let last = -1;
  function paint() {
    if (!el) return;
    let sum = 0;
    try {
      const p = JSON.parse(localStorage.getItem(KEY) || '{}');
      sum = Object.values((p.earned ?? {}) as Record<string, number>).reduce((a, b) => a + b, 0);
    } catch {}
    el.textContent = String(sum);
    if (last >= 0 && sum > last && chip) {
      chip.classList.remove('bump');
      void chip.offsetWidth;
      chip.classList.add('bump');
    }
    last = sum;
  }
  paint();
  window.addEventListener('vc:progress', paint);
  window.addEventListener('storage', paint);

  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const mobile = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (mobile) mobile.hidden = open;
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('vc:lang', a.dataset.setLang!);
      } catch {}
    }),
  );

  // Account chip. Rendered hidden and revealed by JS so a cached page never
  // shows the wrong state for the visitor looking at it.
  function paintAuth() {
    let user: { name?: string; email?: string; admin?: boolean } | null = null;
    try {
      const raw = localStorage.getItem('vc:user');
      if (raw && localStorage.getItem('vc:token')) user = JSON.parse(raw);
    } catch {}
    const acct = document.querySelector<HTMLElement>('[data-acct]');
    const signin = document.querySelector<HTMLElement>('[data-signin]');
    const label = document.querySelector<HTMLElement>('[data-acct-name]');
    if (acct) acct.hidden = !user;
    if (signin) signin.hidden = Boolean(user);
    document
      .querySelectorAll<HTMLElement>('[data-admin-only]')
      .forEach((el) => (el.hidden = !user?.admin));
    if (label && user) label.textContent = (user.name || user.email || '').split(' ')[0].slice(0, 16);
  }
  paintAuth();
  window.addEventListener('vc:auth', paintAuth);
  window.addEventListener('storage', paintAuth);
</script>
