---
import BaseLayout from './BaseLayout.astro';
import ProgressRail from '@/components/ProgressRail.astro';
import CompleteButton from '@/components/widgets/CompleteButton';
import type { ActId, Lang } from '@/data/curriculum';
import { acts } from '@/data/curriculum';
import { href, useT } from '@/i18n/ui';

interface Props {
  lang: Lang;
  kind: 'module' | 'lab';
  slug: string;
  act?: ActId;
  order: number;
  title: string;
  subtitle?: string;
  objective: string;
  description: string;
  minutes: number;
  xp: number;
  cycleStep?: number;
  level?: 1 | 2 | 3;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
  headings: { depth: number; slug: string; text: string }[];
  isFallback?: boolean;
}

const {
  lang, kind, slug, act, order, title, subtitle, objective, description,
  minutes, xp, cycleStep, level, prev, next, headings, isFallback = false,
} = Astro.props;

const t = useT(lang);
const actMeta = acts.find((a) => a.id === act);
const indexHref = href(lang, kind === 'module' ? 'learn' : 'labs');
const num = String(order).padStart(2, '0');
---

<BaseLayout lang={lang} title={title} description={description} act={act}>
  <article class="lesson">
    <div class:list={['shell', { 'with-rail': kind === 'module' }]}>
      {kind === 'module' && <div class="rail-col"><ProgressRail lang={lang} current={slug} /></div>}

      <div class="main">
        <header class="head">
          <div class="crumbs">
            <a href={indexHref}>{kind === 'module' ? t('lesson.allModules') : t('lesson.allLabs')}</a>
            <span aria-hidden="true">/</span>
            <span>{kind === 'module' ? t('lesson.module') : t('lesson.lab')} {num}</span>
          </div>

          <div class="tags">
            {actMeta && <span class="pill pill-act">{t('lesson.act')} {actMeta.n} · {actMeta.title[lang]}</span>}
            {cycleStep && <span class="pill">{t('lesson.step')} {cycleStep}/9</span>}
            {level && <span class="pill">{t('lesson.level')} {level}</span>}
            <span class="pill">{minutes} {t('lesson.minutes')}</span>
            <span class="pill pill-act">+{xp} XP</span>
          </div>

          <h1>{title}</h1>
          {subtitle && <p class="sub">{subtitle}</p>}

          <div class="objective">
            <span class="obj-k">{t('lesson.objective')}</span>
            <p>{objective}</p>
          </div>

          {isFallback && <p class="fallback">{t('lesson.fallbackNotice')}</p>}
        </header>

        <div class="sec-controls no-print" data-sec-controls hidden>
          <button type="button" data-expand-all></button>
          <span class="count" data-sec-count></span>
        </div>

        <div class="prose-vc"><slot /></div>

        <footer class="foot">
          <div class="done">
            <CompleteButton client:visible lang={lang} id={`${kind}:${slug}`} xp={xp} />
          </div>
          <nav class="pager" aria-label="Pagination">
            {
              prev ? (
                <a href={prev.href} class="pg prev">
                  <span class="k">← {t('lesson.previous')}</span>
                  <span class="t">{prev.title}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a href={next.href} class="pg next">
                  <span class="k">{t('lesson.nextUp')} →</span>
                  <span class="t">{next.title}</span>
                </a>
              )
            }
          </nav>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .lesson { padding: 40px 0 0; }
  .shell { width: min(1180px, 100% - 40px); margin-inline: auto; display: grid; gap: 48px; }
  .rail-col { display: none; }
  .main { min-width: 0; max-width: 760px; }
  .shell:not(.with-rail) .main { margin-inline: auto; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font: 400 12px/1 var(--font-mono); color: var(--color-faint); }
  .crumbs a { color: var(--color-muted); text-decoration: none; }
  .crumbs a:hover { color: #fff; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 20px; }
  h1 { font-size: clamp(36px,6.58vw, 46px); font-weight: 300; }
  .sub { margin: 16px 0 0; font: 300 clamp(18px, 2.44vw, 20px)/1.45 var(--font-display); color: var(--color-muted); }
  .objective { margin-top: 28px; padding: 18px 20px; border-radius: 16px; border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.03); }
  .obj-k { font: 500 11px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--act); }
  .objective p { margin: 8px 0 0; font-size: 17px; color: #fff; }
  .fallback { margin-top: 16px; padding: 12px 16px; border-radius: 12px; border: 1px dashed var(--color-line-strong); font-size: 14px; color: var(--color-amber); }
  .toc { margin: 36px 0 0; padding: 18px 20px; border-radius: 16px; border: 1px solid var(--color-line); background: rgb(255 255 255 / 0.02); }
  .toc p { margin: 0 0 10px; font: 500 11px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-faint); }
  .toc ol { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .toc li::marker { color: var(--color-faint); font-family: var(--font-mono); font-size: 12px; }
  .toc a { color: var(--color-muted); text-decoration: none; font-size: 15px; }
  .toc a:hover { color: var(--act); }
  .prose-vc { margin-top: 44px; }
  .foot { margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--color-line); }
  .pager { display: grid; gap: 12px; margin-top: 36px; }
  .pg { display: grid; gap: 6px; padding: 20px 22px; border-radius: 18px; border: 1px solid var(--color-line-strong); text-decoration: none; transition: border-color 0.3s, transform 0.5s var(--ease-out-expo); }
  .pg:hover { border-color: var(--act); transform: translateY(-3px); }
  .pg .k { font: 500 11px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--act); }
  .pg .t { font: 400 19px/1.3 var(--font-display); color: #fff; }
  .next { text-align: right; }
  @media (min-width: 720px) { .pager { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) {
    .shell.with-rail { grid-template-columns: 250px 1fr; }
    .rail-col { display: block; }
    .lesson { padding-top: 56px; }
  }
</style>

<script>
  const secs = Array.from(document.querySelectorAll<HTMLDetailsElement>('.sec'));
  const controls = document.querySelector<HTMLElement>('[data-sec-controls]');
  const btn = document.querySelector<HTMLButtonElement>('[data-expand-all]');
  const count = document.querySelector<HTMLElement>('[data-sec-count]');
  const KEY = 'vc:open:' + location.pathname;
  const kk = document.documentElement.lang === 'kk';
  const LABEL = kk ? { open: 'Бәрін ашу', close: 'Бәрін жабу' } : { open: 'Expand all', close: 'Collapse all' };

  if (secs.length) {
    controls!.hidden = false;

    // restore whatever the reader had open last time on this page
    try {
      const saved: string[] = JSON.parse(sessionStorage.getItem(KEY) || '[]');
      secs.forEach((s) => { if (s.dataset.section && saved.includes(s.dataset.section)) s.open = true; });
    } catch {}

    const paint = () => {
      const open = secs.filter((s) => s.open).length;
      if (count) count.textContent = open + '/' + secs.length;
      if (btn) btn.textContent = open === secs.length ? LABEL.close : LABEL.open;
    };

    const save = () => {
      try {
        sessionStorage.setItem(KEY, JSON.stringify(secs.filter((s) => s.open).map((s) => s.dataset.section)));
      } catch {}
    };

    secs.forEach((s) => s.addEventListener('toggle', () => { paint(); save(); }));

    btn?.addEventListener('click', () => {
      const openAll = secs.some((s) => !s.open);
      secs.forEach((s) => (s.open = openAll));
      paint(); save();
    });

    // a link to #some-heading must open the section that holds it
    const openTarget = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const el = document.getElementById(id);
      const sec = el?.closest('details.sec') as HTMLDetailsElement | null;
      if (sec && !sec.open) { sec.open = true; paint(); }
      el?.scrollIntoView({ block: 'start' });
    };
    window.addEventListener('hashchange', openTarget);
    openTarget();

    // Ctrl+F should be able to find collapsed text
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'f') secs.forEach((s) => (s.open = true));
    });

    paint();
  }
</script>
